::SCORE::
** 豆豆是個好貓咪：漸進管弦變奏曲 (Dodo: Progressive Orchestral Variations) **
!= 116
?= C
<4/4>

~ "曲：zonble, friend & Antigravity"
~ "詞：zonble"
~ "形式：由單音樂器極簡陳述，逐層疊加至管弦大合奏的漸進式變奏曲 (Progressive Crescendo/Layers)"

/*
=============================================================================
【真正的「層層遞進」發展脈絡 (Evolutionary Blueprint)】
=============================================================================
波麗露 / 艾爾加風格的漸進堆疊：

1. [階段 1: 極簡核心 - 孤獨的單簧管]
   - 完全沒有伴奏！只有一支 Clarinet (單簧管) 在安靜的房間裡吹出最初的動機。
   - 像是一隻小貓咪在清晨輕輕喵了一聲。

2. [階段 2: 雙聲部對位 - 大提琴悄悄加入]
   - 加入 Cello (大提琴) 提供緩慢、溫柔的單音低音線。
   - 單簧管續唱主題，兩條旋律線條交織，純淨的室內樂二重奏。

3. [階段 3: 四重奏和聲成形 - 弦樂四重奏]
   - Violin1 接過旋律，Violin2、Viola、Cello 加入。
   - 第一次出現完整四部和聲與輕快跳音，豆豆開始在客廳輕手輕腳地走動。

4. [階段 4: 織體加速奔馳 - 長笛花彩木管組]
   - 弦樂維持律動，Flute (長笛) 與 Oboe (雙簧管) 加入，並首次引入十六分音符花彩音階！
   - 節奏開始流動活躍，像貓咪看到飛舞的毛線球。

5. [階段 5: 宏大高潮 - 全管弦樂團齊奏 (Tutti Grandioso)]
   - 銅管 (Trumpet, Horn) 與定音鼓 (Timpani) 震撼進場！
   - 全樂團所有聲部以最厚實的音響齊鳴，所有的聲部都在這個最終高潮完全綻放！
=============================================================================
*/

/* --------------------------------------------------------------------------
   階段 1: Clarinet 孤身清唱 (Solo Monophonic)
   乾乾淨淨、完全不帶任何和弦或裝飾
   -------------------------------------------------------------------------- */
stage1_solo:Clarinet@|0|{
    <4*>
    /* 豆豆是個好貓咪，豆豆是個好貓咪 */
    5_ 5_ 1 1 | 2 1 6_ - | 2 2 2 2 | 3 2 1 - |
    3 4 5 5 | 6 5 4 - | 3 3 2 2 | 1 - - - |
}

/* --------------------------------------------------------------------------
   階段 2: 雙聲部室內樂 (Two-Part Duet)
   單簧管唱主題，大提琴加入對位低音
   -------------------------------------------------------------------------- */
stage2_duo:Clarinet@|0|{
    <4*>
    5_ 5_ 1 1 | 2 1 6_ - | 2 2 2 2 | 3 2 1 - |
    3 4 5 5 | 6 5 4 - | 3 3 2 2 | 1 - - - |
}

stage2_duo:Cello@|0|{
    <2*>
    /* 單純沉著的二度、四度步進對位 */
    1_ 3_ | 4_ 1_ | 2_ 5_ | 1_ - |
    1_ 3_ | 4_ 2_ | 1_ 5_ | 1_ - |
}

/* --------------------------------------------------------------------------
   階段 3: 弦樂四重奏 (String Quartet Chamber)
   第一小提琴唱出主題，其餘弦樂帶來典雅的四部和聲與微小律動
   -------------------------------------------------------------------------- */
stage3_quartet:Violin1@|0|{
    <4*>
    5_ 5_ 1 1 | 2 1 6_ - | 2 2 2 2 | 3 2 1 - |
    3 4 5 5 | 6 5 4 - | 3 3 2 2 | 1 - - - |
}

stage3_quartet:Violin2@|0|{
    <4*>
    3_ 3_ 5_ 5_ | 6_ 5_ 4_ - | 4_ 4_ 4_ 4_ | 5_ 4_ 3_ - |
    5_ 6_ 7_ 7_ | 1 7_ 6_ - | 5_ 5_ 4_ 4_ | 3_ - - - |
}

stage3_quartet:Viola@|0|{
    <4*>
    1 1 3 3 | 4 3 1 - | 6_ 6_ 7_ 7_ | 1 7_ 1 - |
    1 1 2 2 | 4 3 2 - | 1 1 7_ 7_ | 1 - - - |
}

stage3_quartet:Cello@|0|{
    <4*>
    1_ - 1_ - | 4_ - 4_ - | 2_ - 5_ - | 1_ - - - |
    1_ - 3_ - | 4_ - 5_ - | 1_ - 5_ - | 1_ - - - |
}

/* --------------------------------------------------------------------------
   階段 4: 木管注入花彩活力 (Woodwind Coloration & 16th Motion)
   弦樂維持基礎，長笛與小提琴展開活潑的十六分音符追逐，低音提琴加入
   -------------------------------------------------------------------------- */
stage4_woodwinds:Flute@|0|{
    <16*>
    /* 長笛在此刻首次引入十六分音符圍繞主題音跑動 */
    5 6 7 5   5 6 7 5   1^ 7 1^ 2^   1^ 2^ 3^ 1^ |
    2^ 1^ 2^ 3^   1^ 7 1^ 2^   6 7 1^ 6   5 6 7 5 |
    2^ 1^ 2^ 3^   2^ 1^ 2^ 3^   2^ 3^ 4^ 2^   5^ 4^ 3^ 2^ |
    3^ 2^ 3^ 4^   2^ 1^ 2^ 3^   1^ 7 1^ 2^   1^ - - - |
    3^ 2^ 3^ 4^   5^ 4^ 5^ 6^   6^ 5^ 6^ 7^   5^ - - - |
    4^ 3^ 4^ 5^   3^ 2^ 3^ 4^   2^ 1^ 2^ 3^   1^ - - - |
}

stage4_woodwinds:Violin1@|0|{
    <4*>
    5_ 5_ 1 1 | 2 1 6_ - | 2 2 2 2 | 3 2 1 - |
    3 4 5 5 | 6 5 4 - | 3 3 2 2 | 1 - - - |
}

stage4_woodwinds:Violin2@|0|{
    <4*>
    /* 八分音符輕快跳音 */
    1 3 1 3 | 4 6 4 6 | 2 4 5 7 | 1 3 1 - |
    1 5 3 5 | 4 6 5 7 | 1 5 5 7 | 1 - - - |
}

stage4_woodwinds:Viola@|0|{
    <4*>
    [1] 0 [1] 0 | [4] 0 [4] 0 | [2m] 0 [5] 0 | [1] 0 0 0 |
    [1] 0 [3m] 0 | [4] 0 [5] 0 | [1] 0 [5] 0 | [1] 0 0 0 |
}

stage4_woodwinds:Cello@|0|{
    <4*>
    1_ 0 3_ 0 | 4_ 0 6_ 0 | 2_ 0 5_ 0 | 1_ 3_ 5_ 0 |
    1_ 0 3_ 0 | 4_ 0 5_ 0 | 1_ 0 5_ 0 | 1_ - - - |
}

stage4_woodwinds:Contrabass@|0|{
    <2*>
    1__ - | 4__ - | 5__ - | 1__ - |
    1__ - | 4__ - | 5__ - | 1__ - |
}

/* --------------------------------------------------------------------------
   階段 5: 全團大齊奏 (Grand Finale Tutti)
   這時才讓銅管（小號、法國號）、定音鼓隆重登場！能量全面釋放！
   -------------------------------------------------------------------------- */
stage5_tutti:Trumpet@|0|{
    <4*>
    /* 嘹亮的小號主奏，高貴非凡的豆豆皇帝 */
    5 5 1^ 1^ | 2^ 1^ 6 - | 2^ 2^ 2^ 2^ | 3^ 2^ 1^ - |
    3^ 4^ 5^ 5^ | 6^ 5^ 4^ - | 3^ 3^ 2^ 2^ | 1^ - - - |
    <2*>
    [1^] [5] | [1^] [5] | [1^] - | - - |
}

stage5_tutti:Horn@|0|{
    <4*>
    1 1 3 3 | 4 4 4 - | 2 2 5 5 | 5 5 3 - |
    5 6 7 7 | 1^ 7 6 - | 5 5 5 5 | 3 - - - |
    <2*>
    [1] [5] | [1] [5] | [1] - | - - |
}

stage5_tutti:Flute@|0|{
    <16*>
    5 6 7 1^   2^ 3^ 4^ 5^   6^ 5^ 4^ 3^   2^ 1^ 7 6 |
    2^ 3^ 4^ 5^   6^ 7^ 1^^ 2^^   3^^ 2^^ 1^^ 7^   6^ 5^ 4^ 3^ |
    1^ 3^ 5^ 1^^   2^ 4^ 6^ 2^^   3^ 5^ 7^ 3^^   1^^ - - - |
    1^^ 7^ 6^ 5^   4^ 3^ 2^ 1^   5 6 7 1^   2^ 3^ 4^ 5^ |
    1^^ - - -   5^ - - -   1^^ - - -   - - - - |
}

stage5_tutti:Violin1@|0|{
    <16*>
    5_ 6_ 7_ 1   2 3 4 5   6 5 4 3   2 1 7_ 6_ |
    2 3 4 5   6 7 1^ 2^   3^ 2^ 1^ 7   6 5 4 3 |
    1 3 5 1^   2 4 6 2^   3 5 7 3^   1^ - - - |
    1^ 7 6 5   4 3 2 1   5_ 6_ 7_ 1   2 3 4 5 |
    1^ - - -   5 - - -   1^ - - -   - - - - |
}

stage5_tutti:Violin2@|0|{
    <4*>
    1 5 1 5 | 4 6 4 6 | 2 5 2 5 | 1 5 1 5 |
    3 5 3 5 | 4 6 4 6 | 1 5 5 7 | 1 5 1 5 |
    <4*>
    1 5 1 5 | 1 - - - |
}

stage5_tutti:Viola@|0|{
    <2*>
    [1] [1] | [4] [4] | [2m] [5] | [1] [1] |
    [1] [3m] | [4] [4] | [1] [5] | [1] [1] |
    [1] [5] | [1] - |
}

stage5_tutti:Cello@|0|{
    <4*>
    1_ 3_ 5_ 3_ | 4_ 6_ 1 6_ | 2_ 4_ 5_ 7_ | 1_ 3_ 5_ 3_ |
    1_ 3_ 5_ 3_ | 4_ 6_ 1 6_ | 1_ 3_ 5_ 7_ | 1_ 3_ 5_ 1 |
    <4*>
    1_ 5_ 1_ 5_ | 1_ - - - |
}

stage5_tutti:Timpani@|0|{
    <4*>
    /* 定音鼓在此處首次現身！震撼滾奏收尾 */
    1_ 0 1_ 0 | 4_ 0 4_ 0 | 5_ 0 5_ 0 | 1_ - - 0 |
    1_ 0 1_ 0 | 4_ 0 4_ 0 | 1_ 0 5_ 0 | 1_ - - 0 |
    1_ 5_ 1_ 5_ | 1_ - - - |
}

stage5_tutti:Contrabass@|0|{
    <1*>
    1__ | 4__ | 5__ | 1__ |
    1__ | 4__ | 5__ | 1__ |
    <2*>
    1__ 5__ | 1__ - |
}

/* --------------------------------------------------------------------------
   全曲架構推進流程 (Progressive Evolutionary Playback)
   單簧管清唱 -> 雙聲部對位 -> 弦樂四重奏 -> 木管花彩流動 -> 全團大合奏
   -------------------------------------------------------------------------- */
-> stage1_solo -> stage2_duo -> stage3_quartet -> stage4_woodwinds -> stage5_tutti ->#
