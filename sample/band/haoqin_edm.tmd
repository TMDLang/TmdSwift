   OUTRO: 歡樂電音大謝幕
   ============================================================ */

Outro:Brass@|0|{
    <8*>
    | 1^ - 5 - 3 - 5 - | 1^ - - - - - - - |
}

Outro:Trumpet@|0|{
    <8*>
    | 3^ - 1^ - 5 - 1^ - | 3^ - - - - - - - |
}

