/* ============================================================
   VERSE 3: 沙場冷月 (EDM BREAKDOWN -> 狂暴 BUILDUP -> THE DROP!)
   ============================================================ */

Verse3:Trumpet@|0|{
    <8*>
    /* 沙場冷月大抽離，只剩浪漫合成電音 */
    | 6 - - - 3 - - 3 | 6 - 1^ - - - - 6 | 1^ - 7 - 6 - - 5' | 6 - - - - - - - |
    | 2^ - - - 6 - - 6 | 2^ - 4^ - - - - 2^ | 3^ - 2^ - 1^ - - 2^ | 3^ - - - - - 3 5 |
    /* 掀起千層波浪 展翅飛向萬里長空 (加速衝向主升級) */
    | 3^ - - 2^ 1^ 2^ 1^ 7 | 6 - - - - - 7 6 | 5 - - 6 1^ 7 - 1^ | 2^ - - - - - - 0 |
}

Verse3:Strings@|0|{
    <2*>
    /* 懸疑神秘的弦樂鋪底 (Trance Pad) */
    | [6m] - | [6m] - | [4] [5] | [6m] - |
    | [2m] - | [2m] - | [1] [2m] | [3] - |
    | [6m] - | [4] - | [5] - | [5] - |
}

Verse3:Bass@|0|{
    <8*>
    /* 前半段只有底層長音，後半段開始狂踩八分音符 */
    | 6,_ - - - 3,_ - - - | 6,_ - - - - - - - | 4,_ - - - 5,_ - - - | 6,_ - - - - - - - |
    | 2,_ - - - 6,_ - - - | 2,_ - - - - - - - | 1,_ - - - 2,_ - - - | 3,_ - - - - - - - |
    /* Buildup 連踩 */
    | 6,_ 6,_ 6,_ 6,_ 6,_ 6,_ 6,_ 6,_ | 4,_ 4,_ 4,_ 4,_ 4,_ 4,_ 4,_ 4,_ |
    | 5,_ 5,_ 5,_ 5,_ 5,_ 5,_ 5,_ 5,_ | 5,_ 5,_ 5,_ 5,_ 5,_ 5,_ 5,_ 5,_ |
}

Verse3:Drums@|0|{
    <16*>
    /* 前 8 小節大鼓小鼓完全靜音 (Breakdown) */
    | 0 - - - - - - - - - - - - - - - | 0 - - - - - - - - - - - - - - - |
    | 0 - - - - - - - - - - - - - - - | 0 - - - - - - - - - - - - - - - |
    | 0 - - - - - - - - - - - - - - - | 0 - - - - - - - - - - - - - - - |
    | 0 - - - - - - - - - - - - - - - | 0 - - - - - - - - - - - - - - - |
    /* 後 4 小節：瘋狂連續小鼓 Buildup (噠噠噠噠噠噠噠噠) */
    | s - s - s - s - s - s - s - s - | s s s s s s s s s s s s s s s s |
    | s s s s s s s s s s s s s s s s | s s s s s s s s X X X X X X X X |
}

/* ============================================================
   VERSE 4: THE DROP! 萬人電音趴終極大噴發 (全場跳起來！)
   ============================================================ */

Verse4:Trumpet@|0|{
    <8*>
    /* 誰沒有做過那關山夢 誰沒有興起過塞上行 */
    | 5 - 3 4 5  1^ - 1^ | 6 7 1^ 6 5 - - - | 5 - 3 4 5  3^ - 3^  | 4^ 3^ 2^ 1^ 2^ - - - |
    /* 大地留下 男兒足跡 歷史何需刻上英名 */
    | 5 - 5 - 3^ - 2^- | 1^ 2^ 7 5 6 - - - | 7 6 5 6 7 3^ - 2^ | 1^ - - - - - - - |
}

Verse4:Brass@|0|{
    <8*>
