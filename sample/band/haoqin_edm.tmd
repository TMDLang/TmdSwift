    | 0 1_ 0 1_ 0 6,_ 0 6,_ | 0 4,_ 0 4,_ 0 1_ 0 1_ | 0 5,_ 0 5,_ 0 5,_ 0 5,_ | 0 1_ 0 1_ 0 1_ 0 1_ |
}

Verse4:Drums@|0|{
    <16*>
    /* 終極全開 咚滋噠滋 */
    | X - t - s - t - X - t - s - t - | X - t - s - t - X - t - s - t - |
    | X - t - s - t - X - t - s - t - | X - t - s - t - X - t - s - t - |
    | X - t - s - t - X - t - s - t - | X - t - s - t - X - t - s - t - |
    | X - t - s - t - X - t - s - t - | X - t - s - t - X X s s |
