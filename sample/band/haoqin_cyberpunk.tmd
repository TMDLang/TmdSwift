/* ============================================================
   VERSE 3: 沙場冷月 (冷冽大抽離 -> 重低音心跳 -> 暴風雨重裝衝擊)
   ============================================================ */

Verse3:Trumpet@|0|{
    <8*>
    /* 沙場冷月，如銀翼殺手霓虹廢墟獨白 */
    | 6, - - - 3, - - 3, | 6, - 1^ - - - - 6, | 1^ - 7, - 6, - - 5' | 6, - - - - - - - |
    | 2^ - - - 6, - - 6, | 2^ - 4^ - - - - 2^ | 3,^ - 2^ - 1^ - - 2^ | 3,^ - - - - - 3, 5 |
    /* 掀起千層波浪 展翅飛向萬里長空 (引擎點火推進！) */
    | 3,^ - - 2^ 1^ 2^ 1^ 7, | 6, - - - - - 7, 6, | 5 - - 6, 1^ 7, - 1^ | 2^ - - - - - - 0 |
}

Verse3:Strings@|0|{
    <2*>
    | [6,m] - | [6,m] - | [4] [5] | [6,m] - |
    | [2m] - | [2m] - | [1] [2m] | [3m] - |
    | [6,m] - | [4] - | [5] - | [5] - |
}

Verse3:Bass@|0|{
    <16*>
    /* 前段極低頻沉重重音，後段高速推進 */
    | 6,_ - - - - - - - - - - - - - - - | 6,_ - - - - - - - - - - - - - - - |
    | 4,_ - - - - - - - 5,_ - - - - - - - | 6,_ - - - - - - - - - - - - - - - |
    | 2,_ - - - - - - - - - - - - - - - | 2,_ - - - - - - - - - - - - - - - |
    | 1_ - - - - - - - 2,_ - - - - - - - | 3,_ - - - - - - - - - - - - - - - |
    /* 展翅飛向萬里長空：重擊推進 */
    | 6,_ 6,_ 6, 6,_ 6,_ 6,_ 6, 6,_ | 4,_ 4,_ 4, 4,_ 4,_ 4,_ 4, 4,_ |
    | 5,_ 5,_ 5, 5,_ 5,_ 5,_ 5, 5,_ | 5,_ 5,_ 5,_ 5,_ 5,_ 5,_ 5,_ 5,_ |
}

Verse3:Drums@|0|{
    <16*>
    /* 沉重緩慢的大鼓心跳 (Heartbeat Stomp) */
    | X - - - - - - - - - - - - - - - | X - - - - - - - - - - - - - - - |
    | X - - - - - - - X - - - - - - - | X - - - - - - - - - - - - - - - |
    | X - - - - - - - - - - - - - - - | X - - - - - - - - - - - - - - - |
    | X - - - - - - - X - - - - - - - | X - - - - - - - - - - - - - - - |
    /* 推進滾奏 (Snare Accelerating) */
    | s - - - s - - - s - - - s - - - | s - s - s - s - s - s - s - s - |
    | s s s s s s s s s s s s s s s s | X X X X X X X X S S S S S S S S |
}

