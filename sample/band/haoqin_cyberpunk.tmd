::SCORE::
** 豪情 (Cyberpunk 2077 / Dark Synthwave 重裝工業電音版) **

~ "lyricist: 鍾景妹"
~ "composer: 李文堂"
~ "remixer: Antigravity Cyber Division"

!= 124
?= B
<4/4>

/* ============================================================
   INTRO: 重裝機械踩踏 + 賽博龐克滾動低音 (Rolling Bass)
   ============================================================ */

Intro:Drums@|0|{
    <16*>
    /* 沉重工業大鼓 + 16分機械金屬打擊 (Industrial Techno Stomp) */
    | X x t x S x t x X x t x S x t x | X x t x S x t x X x t x S x t x |
    | X x t x S x t x X x t x S x t x | X x t x S x t x X x t x S x t x |
    | X x t x S x t x X x t x S x t x | X x t x S x t x X x t x S x t x |
    | X x t x S x t x X x t x S x t x | X X X X S S S S X X X X S S S S |
}

Intro:Bass@|0|{
    <16*>
    /* 經典 Dark Synthwave 八度跳躍重低音 (1_ 1_ 1_ 1) */
    | 1_ 1_ 1 1_ 1_ 1_ 1 1_ | 1_ 1_ 1 1_ 1_ 1_ 1 1_ | 6,_ 6,_ 6, 6,_ 6,_ 6,_ 6, 6,_ | 5,_ 5,_ 5, 5,_ 5,_ 5,_ 5, 5,_ |
    | 1_ 1_ 1 1_ 1_ 1_ 1 1_ | 1_ 1_ 1 1_ 1_ 1_ 1 1_ | 6,_ 6,_ 6, 6,_ 6,_ 6,_ 6, 6,_ | 7,_ 7,_ 7, 7,_ 7,_ - - - |
}

Intro:Distortion@|+4|{
    <8*>
    /* 賽博龐克重型暗黑鋸齒波 Riff */
    | [1] - [1] - 0 [1] [1] - | [6,] - [6,] - 0 [6,] [6,] - |
    | [4] - [4] - 0 [4] [4] - | [5] - - - - - - - |
}

Intro:Strings@|+4|{
    <2*>
    /* 冷酷神秘的賽博弦樂懸浮音 */
    | [1m] - | [6,] - | [4m] - | [5m] - |
}

/* ============================================================
   VERSE 1: 蔚藍的天空 (冷酷電子行軍，史詩科技感)
   ============================================================ */

Verse1:Trumpet@|0|{
    <8*>
    /* 「蔚藍的天空 坦蕩心胸」轉為冷冽史詩小調 */
    | 5 - 3, 4 5 - 1^ - | 6, 7, 1^ 6, 5 - - - |
    /* 「燦爛的陽光 炙熱豪情」 */
    | 5 - 3, 4 5 - 3,^ - | 4^ 3,^ 2^ 1^ 2^ - - - |
    /* 「大海茫茫 呼我揚帆」 */
    | 5 - 5 - 3,^ - 2^- | 1^ 2^ 7, 5 6, - - - |
    /* 「白雲朵朵 喚我出征」 */
    | 7, 6, 5 6, 7, 7, - 1^ | 2^ - - - - - - 0 |
}

Verse1:Distortion@|0|{
    <8*>
    /* 重擊切分重音 (Heavy Stabs) */
    | [1] - 0 [1] [1] - 0 [1] | [6,] - 0 [6,] [6,] - 0 [6,] | [1] - 0 [1] [1] - 0 [1] | [4] - [4] - [5] - [5] - |
    | [1] - 0 [1] [6,] - 0 [6,] | [4] - 0 [4] [1] - 0 [1] | [5] - [5] - [5] - [5] - | [5] - - - - - - - |
}

Verse1:Bass@|0|{
    <16*>
    | 1_ 1_ 1 1_ 1_ 1_ 1 1_ | 6,_ 6,_ 6, 6,_ 6,_ 6,_ 6, 6,_ | 1_ 1_ 1 1_ 1_ 1_ 1 1_ | 4,_ 4,_ 4, 4,_ 5,_ 5,_ 5, 5,_ |
    | 1_ 1_ 1 1_ 6,_ 6,_ 6, 6,_ | 4,_ 4,_ 4, 4,_ 1_ 1_ 1 1_ | 5,_ 5,_ 5, 5,_ 5,_ 5,_ 5, 5,_ | 5,_ 5,_ 5,_ 5,_ 5,_ 5,_ 5,_ 5,_ |
}

Verse1:Strings@|0|{
    <2*>
    | [1m] - | [6,] - | [1m] - | [4m] [5m] |
    | [1m] [6,] | [4m] [1m] | [5m] - | [5m] - |
}

Verse1:Drums@|0|{
    <16*>
    | X x t x S x t x X x t x S x t x | X x t x S x t x X x t x S x t x |
    | X x t x S x t x X x t x S x t x | X x t x S x t x X x t x S x t x |
