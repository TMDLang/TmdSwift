/* =============================================================
   v4: 主歌四（16 小節）
   原曲旋律完全保留，鼓組重擊與連音過門原汁原味繼承，
   將貝斯與柱狀鋼琴和聲精確校準為支持旋律的王道色彩。
   ============================================================= */

v4:piano@|-1| {
    <4*>
    /*  我不過  是  肉    體    凡     軀 */
    | 0 3 1 3 | 4 - 1 - | 6_ - 4  - | 3 - - - |
    /*  有什麼  能   被   我    左     右？ */
    | 0 3 1 3 | 5 - 3 - | 2_ - 5  - | 3 - - - | 
    /*         我   還    是   忍不   住  可 惜*/
    | - - - - | 4 - 1 - | 6_ (6_ 6_)%(-) 4 3 | 3  1  0 0 |
    /*不  只    是我         淹沒     在    遺忘   的  洪流   */
    | 5 - 3 - | 2 5_ 0 5_ | (5 5)%(-) 1 (5 5)%(-) 6 | 5 3 - - |
}

v4:Clarinet@|-1| {
    <4*>
    /*  我不過  是  肉    體    凡     軀 */
    | 0 3 1 3 | 4 - 1 - | 6_ - 4  - | 3 - - - |
    /*  有什麼  能   被   我    左     右？ */
    | 0 3 1 3 | 5 - 3 - | 2_ - 5  - | 3 - - - | 
    /*         我   還    是   忍不   住  可 惜*/
    | - - - - | 4 - 1 - | 6_ (6_ 6_)%(-) 4 3 | 3  1 - - |
    /*不  只    是我    會   淹沒     在    遺忘   的  洪流   */
    | 5 - 3 - | 2 5_ 0 5_ | (5 5)%(-) 1 (5 5)%(-) 6 | 5 3 - - |
}

