/* =============================================================
   v3: 主歌三（16 小節）
   原曲旋律完全保留。
   和聲改為經典的 4-3-2-6 / 4-1-2-5 推進，強化悲傷與激昂交織的宿命感。
   ============================================================= */

v3:piano@|-1| {
    <4*>
    /*  我一向  都  平     凡   無     奇*/
    | 0 3 1 3 | 4 - 1 - | 6_ - 4  - | 3 - - - |
    /*  我根本  都  無     足   輕     重*/
    | 0 3 1 3 | 5 - 3 - | 2_ - 5  - | 3 - - - | 
    /*         我   居    然   從來  沒   想過*/
    | - - - - | 4 - 1 - | 6_ (6_ 6_)%(-) 4 3 | 3  1  0 0 |
    /* 物 理   法則       對  誰 都  適用    */
    | 5 - 3 - | 2 5_ 0 0 | 5 - 5 6 | 5 3 - - |
}

