    | 2__ - - - | 2__ - - - | 3__ - - - | 3__ - - - |
    | 4__ - - - | 4__ - - - | 5__ - - - | 5__ - - - |
    | 2__ - - - | 5__ - - - | 6__ - - - | - - - - |
}

end:String-Pad@|0| {
