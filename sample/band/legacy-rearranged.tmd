    <4*>
    | 4__ - - - | 4__ - - - | 3__ - - - | 3__ - - - |
    | 2__ - - - | 2__ - - - | 6__ - - - | 6__ - - - |
    | 4__ - - - | 4__ - - - | 3__ - - - | 3__ - - - |
    | 2__ - - - | 5__ - - - | 1_ - - - | 5__ - - - |
}

