::SCORE::
** Legacy (Re-arranged) **
! = 125
? = E
<4/4>

/* =============================================================
   Demo:
   - With Vocal: https://www.youtube.com/watch?v=oCbqgfQBVMw
   - Instrumental: https://www.youtube.com/watch?v=W85DBL2xsHc

   Intro: 8 小節
   鋼琴與弦樂鋪陳優雅感傷的色彩，修復原曲打錯的 [2)]，
   鼓組以輕柔的踩鑔與邊擊引導。
   ============================================================= */

intro:String@|0| {
    <4*>
    | 4 - 4 - | 1 - 4 - | 3 - 1 - | 5_ - 3 - |
    | 2 - 1 - | 5_ - 2 - | 1 6_ - - | - - - - |
}

intro:Piano-Chords@|0| {
    <4*>
    | [4] - - - | [5] - - - | [3m] - - - | [6m] - - - |
    | [2m] - - - | [5] - - - | [1] - - - | - - - - |
}

intro:Bass@|0| {
    <4*>
    | 4_ - - - | 5_ - - - | 3_ - - - | 6__ - - - |
    | 2_ - - - | 5_ - - - | 1_ - - - | - - - - |
}

intro:Drum@|0| {
    <4*>
    | x x X x | x x X x | x x X x | x x X x |
    | x x X x | x x X x | x x X x | x x (xxxx)%(-) X |
}

/* =============================================================
   v1: 主歌一（16 小節）
   保持原曲鋼琴主歌旋律與詞對位完全不動（從 @|-1| 弱起進場）。
   重新編寫 Bass 與鋼琴和聲，遵循 1 - 5/7 - 6m - 1/5 - 4 - 1/3 - 2m - 5
   經典抒情走法，徹底消除原本連續 16 拍敲 5 的停滯感。
   ============================================================= */

v1:piano@|-1| {
    <4*>
    /* 多希望  能 夠        一直       牽巨   人的手 */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-)  2 1 | 2 1 5_ - |
    /* 一直在  燈  塔     照  耀    中*/
    | 0 3 2 3 | 5 - 3 - | 2 - 5 - | 3 - - - |
    /* 多希望  能 夠        一直      仰望   我的      英雄 */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | (2 2)%(-) 1 5_ - |
    /*  永遠都  看   不     見    他們  凋 落*/
    | 0 3 2 1 | 7_ - 5_ - | 7_ - 2 3 | 1 6_ - - |
}

v1:Piano-Harm@|0| {
    <4*>
    | [1] - - - | [5] - - - | [6m] - - - | [1] - - - |
    | [4] - - - | [1] - - - | [2m] - - - | [5] - - - |
    | [1] - - - | [5] - - - | [6m] - - - | [1] - - - |
    | [4] - - - | [5] - - - | [6m] - - - | [5] - - - |
}

v1:bass@|0| {
    <4*>
    | 1_ - - - | 7__ - - - | 6__ - - - | 5__ - - - |
    | 4__ - - - | 3__ - - - | 2__ - - - | 5__ - - - |
    | 1_ - - - | 7__ - - - | 6__ - - - | 5__ - - - |
    | 4__ - - - | 5__ - - - | 6__ - - - | 5__ - - - |
}

v1:String@|0| {
    <4*>
    | 1 - - - | 7_ - - - | 1 - - - | 1 - - - |
    | 1 - - - | 1 - - - | 6_ - - - | 7_ - - - |
    | 1 - - - | 7_ - - - | 1 - - - | 1 - - - |
    | 1 - - - | 7_ - - - | 1 - - - | 2 - - - |
}

/* =============================================================
   v2: 主歌二（16 小節）
   旋律保持原曲鋼琴與單簧管重疊完全不動。
   加入輕柔鼓點、對位弦樂與溫暖的低音律動。
   ============================================================= */

v2:piano@|-1| {
    <4*>
    /* 多希望  能 夠        還可      以繼  續犯錯 */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | 2 1 5_ - |
    /* 一直有   原   諒   和   寬    容*/
    | 0 3 2 3 | 5 - 3 - | 2 - 5 - | 3 - - - |
    /* 多希望  能 夠        稍微      理解   這個      宇宙*/
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | (2 2)%(-) 1 5_ - |
    /* 有沒有   熱   寂     以    外的  結果 */
    | 0 3 2 1 | 7_ - 5_ - | 7_ - 2 3 | 1 6_ - - |
}

v2:Clarinet@|-1| {
    <4*>
    /* 多希望  能 夠        還可      以繼  續犯錯 */
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | 2 1 5_ - |
    /* 一直有   原   諒   和   寬    容*/
    | 0 3 2 3 | 5 - 3 - | 2 - 5 - | 3 - - - |
    /* 多希望  能 夠        稍微      理解   這個      宇宙*/
    | 0 3 2 1 | 2 1 - - | 0 (3 3)%(-) 2 1 | (2 2)%(-) 1 5_ - |
    /* 有沒有   熱   寂     以    外的  結果 */
    | 0 3 2 1 | 7_ - 5_ - | 7_ - 2 3 | 1 6_ - - |
}

v2:bass@|0| {
    <4*>
    | 1_ - 1_ - | 7__ - 7__ - | 6__ - 6__ - | 5__ - 5__ - |
    | 4__ - 4__ - | 3__ - 3__ - | 2__ - 2__ - | 5__ - 5__ - |
    | 1_ - 1_ - | 7__ - 7__ - | 6__ - 6__ - | 5__ - 5__ - |
    | 4__ - 4__ - | 5__ - 5__ - | 6__ - 6__ - | 5__ - - - |
}

v2:String@|0| {
    <4*>
    | 3 - - - | 2 - - - | 1 - - - | 7_ - - - |
    | 1 - - - | 1 - - - | 1 - - - | 7_ - - - |
    | 3 - - - | 2 - - - | 1 - - - | 7_ - - - |
    | 1 - - - | 2 - - - | 3 - - - | 2 - - - |
