::SCORE::
** 豪情 (Pure Phrygian / Locrian Death Metal Version) **

~ "lyricist: 鍾景妹"
~ "composer: 李文堂"
~ "arranger: Antigravity Necro Soundlab"

!= 195
?= B
<4/4>

/* ============================================================
   INTRO: 惡魔三全音 (5,) + 降二度 (2,) 邪惡空弦 Chuggin' + Blast Beat
   ============================================================ */

Intro:Drums@|0|{
    <16*>
    /* 狂暴雙踏 + 狂踩小鼓 Blast Beat */
    | X x S x X x S x | X x S x X x S x | X x S x X x S x | X x S x X x S x |
    | X x S x X x S x | X x S x X x S x | X x S x X x S x | X X X X S S S S |
}

Intro:Bass@|0|{
    <16*>
    /* 經典死金 0-1-0-6 (1_ 2,_ 1_ 5,_) 絞殺 Riff */
    | 1_ 1_ 2,_ 1_ 1_ 1_ 5,_ 1_ | 1_ 1_ 2,_ 1_ 1_ 1_ 2,_ 1_ | 1_ 1_ 2,_ 1_ 1_ 1_ 5,_ 1_ | 1_ 1_ 2,_ 1_ 5,_ 5,_ 2,_ 2,_ |
    | 1_ 1_ 2,_ 1_ 1_ 1_ 5,_ 1_ | 1_ 1_ 2,_ 1_ 1_ 1_ 2,_ 1_ | 1_ 1_ 2,_ 1_ 1_ 1_ 5,_ 1_ | 1_ 1_ 1_ 1_ 1_ - - - |
}

Intro:Distortion@|0|{
    <16*>
    | [1] [1] [2,] [1] [1] [1] [5,] [1] | [1] [1] [2,] [1] [1] [1] [2,] [1] | [1] [1] [2,] [1] [1] [1] [5,] [1] | [1] [1] [2,] [1] [5,] [5,] [2,] [2,] |
    | [1] [1] [2,] [1] [1] [1] [5,] [1] | [1] [1] [2,] [1] [1] [1] [2,] [1] | [1] [1] [2,] [1] [1] [1] [5,] [1] | [1] [1] [1] [1] [1] - - - |
}

Intro:Guitar@|+4|{
    <16*>
    /* 洛克里安調式極致下行惡魔琶音 (Tremolo Picking) */
    | 5,^ 5,^ 4^ 4^ 3,^ 3,^ 2,^ 2,^ | 1^ 1^ 7, 7, 6, 6, 5, 5, | 4 4 3, 3, 2, 2, 1 1 | 5,_ - - - - - - - |
}

/* ============================================================
   VERSE 1: 蔚藍的天空 (完全黑化版：小三度 3, + 降五度 5, + 小二度 2,)
   ============================================================ */

Verse1:Guitar@|0|{
    <8*>
    /* 「蔚藍的天空 坦蕩心胸」-> 烏雲蔽日 亡靈行軍 */
    | 5, - 3, 4 5, - 1^ - | 6, 7, 1^ 6, 5, - - - |
    /* 「燦爛的陽光 炙熱豪情」-> 地獄之火 */
    | 5, - 3, 4 5, - 3,^ - | 4^ 3,^ 2,^ 1^ 2,^ - - - |
    /* 「大海茫茫 呼我揚帆」-> 血海漂流 */
    | 5, - 5, - 3,^ - 2,^- | 1^ 2,^ 7, 5, 6, - - - |
    /* 「白雲朵朵 喚我出征」-> 萬骨枯槁 */
    | 7, 6, 5, 6, 7, 7, - 1^ | 2,^ - - - - - - 0 |
}

