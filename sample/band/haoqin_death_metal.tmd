    | [1] [1] [1] [1] [6,] [6,] [6,] [6,] | [4] [4] [4] [4] [1] [1] [1] [1] | [5,] [5,] [5,] [5,] [2,] [2,] [2,] [2,] | [2,] [2,] [2,] [2,] [2,] - - - |
}

