    <16*>
    | 1_ 1_ 1_ 1_ 1_ 1_ 2,_ 1_ | 6,_ 6,_ 6,_ 6,_ 5,_ 5,_ 5,_ 5,_ | 1_ 1_ 1_ 1_ 1_ 1_ 2,_ 1_ | 4,_ 4,_ 3,_ 3,_ 2,_ 2,_ 2,_ 2,_ |
    | 1_ 1_ 1_ 1_ 6,_ 6,_ 6,_ 6,_ | 4,_ 4,_ 4,_ 4,_ 1_ 1_ 1_ 1_ | 5,_ 5,_ 5,_ 5,_ 2,_ 2,_ 2,_ 2,_ | 2,_ 2,_ 2,_ 2,_ 2,_ - - - |
