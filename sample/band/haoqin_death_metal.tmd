/* ============================================================
   VERSE 2: 誰沒有做過那關山夢 (不協和雙吉他極度扭曲輪奏)
   ============================================================ */

Verse2:Guitar@|0|{
    <8*>
    /* 誰沒有做過那關山夢 誰沒有興起過塞上行 */
    | 5, - 3, 4 5, 1^ - 1^ | 6, 7, 1^ 6, 5, - - - | 5, - 3, 4 5, 3,^ - 3,^ | 4^ 3,^ 2,^ 1^ 2,^ - - - |
    /* 大地留下 男兒足跡 歷史何需刻上英名 */
    | 5, - 5, - 3,^ - 2,^- | 1^ 2,^ 7, 5, 6, - - - | 7, 6, 5, 6, 7, 5, - 2,^ | 1^ - - - - - - 0 |
}

