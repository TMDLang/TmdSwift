/* ============================================================
   VERSE 3: 殘虐 SLAM BREAKDOWN (沙場冷月，暴降至 115 BPM 泥淖重擊)
   ============================================================ */

Verse3:Guitar@|0|{
    <8*>
    {!= 115}
    /* 沙場的冷月 陪我獨醒 (深淵洛克里安調式) */
    | 1 - - - 5,_ - - 5,_ | 1 - 3, - - - - 2, | 3, - 2, - 1 - - 5,_ | 1 - - - - - - - |
    /* 拂曉的寒風 伴我遠行 征帆 */
    | 4 - - - 1 - - 1 | 4 - 5, - - - - 4 | 5, - 4 - 3, - - 2, | 3, - - - - - 1 5, |
    /* 掀起千層波浪 展翅飛向萬里長空 (突然暴走狂飆 220 BPM 黑死金 Blast!) */
    {!= 220}
    | 5, - - 4 3, 4 3, 2, | 1 - - - - - 2, 1 | 7,_ - - 1 3, 2, - 2, | 5, - - - - - - 0 |
}

Verse3:Distortion@|0|{
    <8*>
    {!= 115}
    /* 0-0-0-1 毀滅性重頓點 Slam Chugging */
    | [1] [1] 0 [2,] - 0 [1] [1] | 0 [5,] - 0 [1] [1] [2,] 0 | [1] - [2,] - [5,] - [1] - | [1] - - - - - - - |
    | [4] [4] 0 [5,] - 0 [4] [4] | 0 [1] - 0 [4] [4] [5,] 0 | [5,] - [4] - [3,] - [2,] - | [2,] - - - - - - - |
    {!= 220}
    /* 220 BPM 高速狂轟 */
    | [1] - [2,] - [1] - [5,] - | [1] - [2,] - [1] - [6,] - | [5,] - [4] - [3,] - [2,] - | [5,] - - - - - - - |
}

Verse3:Bass@|0|{
    <8*>
    {!= 115}
    | 1_ 1_ 0 2,_ - 0 1_ 1_ | 0 5,_ - 0 1_ 1_ 2,_ 0 | 1_ - 2,_ - 5,_ - 1_ - | 1_ - - - - - - - |
    | 4_ 4_ 0 5,_ - 0 4_ 4_ | 0 1_ - 0 4_ 4_ 5,_ 0 | 5,_ - 4_ - 3,_ - 2,_ - | 2,_ - - - - - - - |
    {!= 220}
    | 1_ 1_ 2,_ 2,_ 1_ 1_ 5,_ 5,_ | 1_ 1_ 2,_ 2,_ 1_ 1_ 6,_ 6,_ | 5,_ 5,_ 4_ 4_ 3,_ 3,_ 2,_ 2,_ | 5,_ - - - - - - - |
}

Verse3:Drums@|0|{
    <8*>
    {!= 115}
    /* 慢速重踩 Slamming */
    | X - - - S - - - | X - - - S - - - | X - X - S - X - | S S S S X X X X |
    | X - - - S - - - | X - - - S - - - | X - X - S - - - | S S S S S S S S |
    {!= 220}
    /* 終極暴風雨 Blast Beat */
    | X S X S X S X S | X S X S X S X S | X S X S X S X S | X X X X S S S S |
}

