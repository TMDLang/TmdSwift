/* ==========================================================
 * ★ ENDING (6 bars, @|-1|): 西班牙華彩終止式 (Flamenco Cadenza Finale)
 * 前 2 句（Bars 1-4）：原曲呼應動機，弦樂鋪底
 * 第 3 句（Bars 5-6）：吉他高速琶音 + 小號上挑滑音，最後三連 Golpe 俐落定格！
 * ========================================================== */

End:nylonGuitar@|-1| {
    <8*>
    /* Bars 1-2: 呼應句 1（切分裝飾花） */
    | 0 0 0 0 7 1^ 7 5 | 6 - 6 1 3 6 - - |
    /* Bars 3-4: 呼應句 2（衝上高八度顫音） */
    | 0 0 0 0 2^ 3^ 2^ 7 | 6^ - 6 7 1^ 2^ 3^ - |
    /* Bars 5-6: 終極華彩狂飆（Picado 琶音掃弦 + 終止強奏） */
    | 6_ 1 3 6 7 1^ 2^ 3^ | 4^ 3^ 6^ 6^ 6^ - 0 0 |
}

End:Trumpet@|-1| {
    <8*>
    /* Bars 1-2: 嘹亮高音加花 */
    | 0 0 0 0 2^ 0 7 0 | 6 - - - - - - - |
    /* Bars 3-4: 鬥牛上挑音階 */
    | 0 0 0 0 4^ 0 3^ 0 | 2^ - 1^ 7 6 - - - |
    /* Bars 5-6: 高亢長音上滑 + 俐落定格 */
    | 0 0 0 0 3^^ - 4'^^ 5^^ | 6^^ - 6^^ 6^^ 6^^ - 0 0 |
}

End:Strings@|-1| {
    <8*>
    | 0 0 0 0 0 0 0 0 | [6m] - - - - - - - |
    | 0 0 0 0 0 0 0 0 | [6m] - - - - - - - |
    | [4] - - - [5] - - - | [6m] - [6m] [6m] [6m] - 0 0 |
}

End:Guitar@|-1| {
    <8*>
    | [5] - - - [5] - [5] - | [6m] - [6m] [6m] - [6m] - - |
    | [5] - - - [5] - [5] - | [6m] - [6m] [6m] - [6m] - - |
