/* ==========================================================
 * ★ INTERLUDE (I: 16 bars, @|-1|): 佛朗明哥西班牙鬥琴！
 * 前半段（Bars 1-8）：尼龍吉他低音動態深情獨白，小號對位
 * 後半段（Bars 9-16）：衝上高八度顫音（Tremolo），小號與吉他熱血三度合奏！
 * ========================================================== */

I:nylonGuitar@|-1| {
    <8*>
    /* 前半段：原聲低音滑奏與顫音 */
    | 0 0 0 0 7_ 6_ 5_ - |
    | 6_ - 6_ 5_ 6_ - 6_ 5_ | 6_ - 6_ 5_ 6_ - 1 6_ | 5_ - 5_ 3_ 5_ - 5_ 3_ | 5_ - 5_ 3_ 5_ - 6_ 3_ |
    | 2_ - 2_ 1_ 2_ - 2_ 1_ | 2_ - 2_ 1_ - 2_ - 3_ | 1_ 6__ - - - 3' 5 7 |
    /* 後半段：衝上高八度激昂顫音與主旋律狂飆！ */
    | 1^ - 7 6 5 - 4 3 |
    | 6 - 6 5 6 - 6 5 | 6 - 6 5 6 - 1^ 6 | 5 - 5 3 5 - 5 3 | 5 - 5 3 5 - 6 3 |
    | 2 - 2 1 2 - 2 1 | 2 - 2 1 - 2 - 3 | 1 6 - - - - - - |
}

I:Trumpet@|-1| {
    <8*>
    /* 前半段：小號輕柔吹奏高音副旋律 */
    | 0 0 0 0 0 0 0 0 |
    | 1^ - - - 7 - - - | 6 - - - - - 5 - | 7 - - - 6 - - - | 5 - - - - - 3 - |
    | 4 - - - 3 - - - | 2 - - - - 1 - 7_ | 6_ - - - - - - - |
    /* 後半段：小號高亢三度疊音，與吉他交織轟鳴！ */
    | 3^ - - - 2^ - - - |
    | 1^ - 1^ 7 1^ - 1^ 7 | 1^ - 1^ 7 1^ - 3^ 1^ | 7 - 7 5 7 - 7 5 | 7 - 7 5 7 - 1^ 5 |
    | 4 - 4 3 4 - 4 3 | 4 - 4 3 - 4 - 5 | 3 1^ - - - - - - |
}

I:Strings@|-1| {
    <8*>
    /* 前半段：溫暖飽滿的低中音弦樂和聲鋪底 (Bm -> A -> G -> F#) */
    | [6m] - - - - - - - |
    | [6m] - - - - - - - | [6m] - - - - - - - | [5] - - - - - - - | [5] - - - - - - - |
    | [4] - - - - - - - | [4] - - - [5] - - - | [6m] - - - - - - - |
    /* 後半段：全弦樂團高音齊鳴 + 劇院式飽滿和弦爆發推升 (Bm -> A -> G -> F#) */
    | [3'] - - - [3'] - - - |
    | [6m] - - - [6m] - - - | [6m] - - - [6m] - - - | [5] - - - [5] - - - | [5] - - - [5] - - - |
    | [4] - - - [4] - - - | [4] - - - [5] - - - | [6m] - - - - - - - |
}

