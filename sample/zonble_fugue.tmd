::SCORE::
** The ZONBLE Fugue: Baroque Chamber Orchestra **
!= 106
?= C
<4/4>

/* ==============================================================================
 * 【The ZONBLE Baroque Chamber Fugue & The B-A-C-H Cryptogram Tradition】
 *
 * 【歷史典故：巴哈與音高密碼（Musical Cryptogram）】
 * 在西方古典音樂史中，將人名轉譯為音符動機的傳統，始於音樂之父約翰·塞巴斯蒂安·巴哈
 * （Johann Sebastian Bach, 1685–1750）。在德語音名體系中：
 *   B = 降 B (B♭)
 *   A = A
 *   C = C
 *   H = B 自然音 (B♮)
 *
 * 巴哈在晚年集大成之作《賦格的藝術》（Die Kunst der Fuge, BWV 1080）未完成的終曲
 * （Contrapunctus XIV）中，首次將自己的姓名「B-A-C-H」作為第三主題悄然切入。在手稿
 * 的最後，巴哈的兒子卡爾·菲利普·埃馬努埃爾·巴哈（C.P.E. Bach）悲傷地寫下：
 * 「在引入主題 B-A-C-H 的此處，作者與世長辭。」
 * 往後數百年間，李斯特（《B-A-C-H 主題幻想曲與賦格》）、舒曼、布拉姆斯乃至二十世紀
 * 的荀白克與魏本，皆以各自的語彙向此一音高密碼致敬。
 *
 * 【現代延續：Z-O-N-B-L-E 首調唱名密碼系統】
 * 在由阿怪（陳志翰, 1974–2019）奠基、現代工程師延續的 TMD 標記語言時空裡，
 * 作曲家將「Z-O-N-B-L-E」透過首調唱名音高密碼系統（Solfège Cipher）轉譯為主題動機：
 *
 *   Z  ===>  5 (Sol)  [沉穩的起點，四度上行跳躍]
 *   O  ===>  1 (Do)   [落於主音，奠定調性核心]
 *   N  ===>  7 (Ti)   [導音懸掛，帶來強烈戲劇張力]
 *   B  ===>  2 (Re)   [跳躍至上方二度]
 *   L  ===>  6 (La)   [六度開展，如歌般的抒情線條]
 *   E  ===>  3 (Mi)   [優雅落入三音，隨後平穩解決]
 *
 * 核心主題（Subject）：
 *   | 5 - 1 - | 7 2 6 3 | 4 3 2 - | 1 - - - |
 *
 * 【配器編制：巴洛克室內管弦樂團（Baroque Chamber Orchestra）】
 * 告別生硬乾扁的電腦合成鋼琴，採用溫潤圓滑的古典樂隊配置：
 *   - 木管組：長笛（Flute）、雙簧管（Oboe）
 *   - 弦樂組：第一小提琴（Violin1）、第二小提琴（Violin2）、中提琴（Viola）、
 *             大提琴（Cello）、低音提琴（Bass / Contrabass）
 *
 * 音樂進行結構：
 *   Section 1 (Exposition I)   : 長笛獨奏宣佈主題（Dux）
 *   Section 2 (Exposition II)  : 雙簧管於屬調歌唱答題（Comes），長笛對題流動
 *   Section 3 (Exposition III) : 小提琴高歌進入，中提琴低語呼應
 *   Section 4 (Exposition IV)  : 大提琴與低音提琴低八度厚重宣讀，全團壯麗對位
 *   Section 5 (Stretto)        : 密接和應（Stretto）各聲部緊密交錯追逐，輝煌大三和弦終止！
 * ============================================================================== */

/* ------------------------------------------------------------------------------
 * Section 1: Flute Solo Dux (長笛吹出輕盈靈動的 ZONBLE 主題)
 * ------------------------------------------------------------------------------ */
expo1:Flute@|0|{
    <4*>
    5 - 1 - | 7 2 6 3 | 4 3 2 - | 1 - - - |
    5 - 1 - | 7 2 6 3 | 2 3 4 5 | 3 - - - |
}

expo1:Strings@|0|{
    <2*>
    /* 柔和弦樂如微風般的長音和聲支撐 */
    1 5_ | 1 1 | 4_ 5_ | 1 1 |
    1 5_ | 1 1 | 2_ 5_ | 1 1 |
}

/* ------------------------------------------------------------------------------
 * Section 2: Comes (雙簧管 Oboe 於屬調歌唱 + 長笛對題跳躍 + 大提琴如歌伴奏)
 * ------------------------------------------------------------------------------ */
expo2:Oboe@|0|{
    <4*>
    /* 雙簧管帶有些許甘甜哀愁的屬調答題 */
    2 - 5 - | 4' 6 3 7 | 1 7 6 - | 5 - - - |
    2 - 5 - | 4' 6 3 7 | 6 7 1 2 | 7 - - - |
}

expo2:Flute@|0|{
    <4*>
    /* 長笛對題跳躍對位 */
    3 4 5 3 | 2 3 4 2 | 1 2 3 1 | 7_ 1 2 7_ |
    1 3 5 1^| 7 6 5 4 | 3 5 4 2 | 1 - - - |
}

expo2:Cello@|0|{
    <4*>
    /* 大提琴溫暖抒情撥奏與弓弦交織 */
    1 - 3 - | 2 - 5 - | 1 - 4 - | 1 - - - |
    1 - 3 - | 2 - 5 - | 6 - 5 - | 1 - - - |
}

/* ------------------------------------------------------------------------------
 * Section 3: Violin & Viola Entry (小提琴高歌 + 中提琴呼應 + 木管交織)
 * ------------------------------------------------------------------------------ */
expo3:Violin1@|0|{
    <4*>
    /* 第一小提琴奏出主調 ZONBLE 主題 */
    5 - 1 - | 7 2 6 3 | 4 3 2 - | 1 - - - |
    5 - 1 - | 7 2 6 3 | 2 3 4 5 | 1 - - - |
}

expo3:Violin2@|0|{
    <4*>
    /* 第二小提琴柔美對位 */
    1 - 3 - | 2 4 1 7_| 1 2 7_ - | 3 5 1 - |
    1 - 3 - | 2 4 1 7_| 6_ 7_ 1 2| 1 - - - |
}

expo3:Viola@|0|{
    <4*>
    3 - 5 - | 4 - 3 - | 2 1 7_ - | 1 - - - |
    3 - 5 - | 4 - 3 - | 2 3 4 2  | 3 - - - |
}

expo3:Flute@|0|{
    <4*>
    1^ - 7 - | 6 - 5 - | 4 - 3 - | 2 - 1 - |
    3 4 5 1^ | 7 - 6 - | 5 4 3 2 | 1 - - - |
}

expo3:Cello@|0|{
    <4*>
    1 - - - | 2 - - - | 4 - 5 - | 1 - - - |
    1 - - - | 2 - - - | 4 - 5 - | 1 - - - |
}

/* ------------------------------------------------------------------------------
 * Section 4: Tutti String & Woodwind (大提琴與低音提琴承接主題，全團壯麗歌唱)
 * ------------------------------------------------------------------------------ */
expo4:Cello@|0|{
    <4*>
    /* 大提琴低音深情宣讀主題 */
    5 - 1 - | 7 2 6 3 | 4 3 2 - | 1 - - - |
    5 - 1 - | 7 2 6 3 | 4 5 5_ 5_| 1 - - - |
}

expo4:Bass@|0|{
    <4*>
    /* 低音提琴低八度厚實襯底 */
    1_ - - - | 5__ - - - | 4__ - - - | 1__ - - - |
    1_ - - - | 2__ - - - | 4__ - 5__ - | 1__ - - - |
}

expo4:Violin1@|0|{
    <4*>
    /* 高音管弦群璀璨交織 */
    3 - 5 - | 4 5 6 - | 7 1^ 2^ - | 3^ 2^ 1^ - |
    5 - 3 - | 2 3 4 - | 5 6 7 -  | 1^ - - - |
}

expo4:Violin2@|0|{
    <4*>
    1 - 3 - | 2 3 4 - | 5 6 7 - | 1^ 7 6 - |
    3 - 1 - | 7_ 1 2 - | 3 4 5 - | 3 - - - |
}

expo4:Viola@|0|{
    <4*>
    5_ - 1 - | 7_ 1 2 - | 3 4 5 - | 6 5 4 - |
    1 - 5_ - | 4_ 5_ 6_ - | 7_ 1 2 - | 1 - - - |
}

expo4:Flute@|0|{
    <4*>
    5 - 1 - | 7 2 6 3 | 4 3 2 - | 1 - - - |
    5 - 1 - | 7 2 6 3 | 2 3 4 5 | 1 - - - |
}

expo4:Oboe@|0|{
    <4*>
    1 - 3 - | 2 4 1 7_| 1 2 7_ - | 3 5 1 - |
    1 - 3 - | 2 4 1 7_| 6_ 7_ 1 2| 1 - - - |
}

/* ------------------------------------------------------------------------------
 * Section 5: Stretto & Grand Chorale (密接和應追逐，管弦大齊奏輝煌結尾)
 * ------------------------------------------------------------------------------ */
stretto:Flute@|0|{
    <4*>
    5 - 1 - | 7 2 6 3 | 5 - 1 - | 7 2 6 3 | 2 3 4 5 | [1 3 5 1^] - - - |
}

stretto:Oboe@|0|{
    <4*>
    - 5 - 1 | - 7 2 6 | 3 4 5 - | 7 2 6 3 | 7 1 2 7_| [5 1 3 5] - - - |
}

stretto:Violin1@|0|{
    <4*>
    - - 5 - | 1 - 7 2 | 6 3 2 - | 1 - 7 2 | 5 5 5 4 | [3 5 1 3] - - - |
}

stretto:Viola@|0|{
    <4*>
    - - - 5 | - 1 - - | 4 - 5 - | 1 - - - | 4 - 5 - | [1 3 5 1] - - - |
}

stretto:Cello@|0|{
    <4*>
    - - - - | 5 - 1 - | 4 - 5 - | 1 - - - | 4 - 5 - | 1 - - - |
}

stretto:Bass@|0|{
    <4*>
    - - - - | 5 - 1 - | 4 - 5 - | 1 - - - | 4 - 5 - | 1 - - - |
}

/* 執行進行管道 */
-> expo1
-> expo2
-> expo3
-> expo4
-> stretto ->#
