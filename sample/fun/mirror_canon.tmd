::SCORE::
** Mirror Canon in Am **
~ "composer: CanonGenerator (Pentatonic Algorithmic Engine)"
~ "style: 羽調式 (Minor Pentatonic), Form: Mirror Canon / Inversion (倒影卡農 / 鏡像卡農)"
!= 96
?= Am
<4/4>

/* Pentatonic Ground Bass Prototype (Basso Ostinato) */
Bass {
    <4*>
    | 6__ - - - | 1_ - - - |
    | 2_ - - - | 3_ - - - |
    | 5_ - - - | 3_ - - - |
    | 2_ - - - | 1_ - - - |
}

/* Pentatonic Variation 0 (Theme) */
Theme {
    <4*>
    | 3 2 5 2 |
    | 1 6_ 2 2 |
    | 6 3 2 3 |
    | 5 2 2 6_ |
    | 1^ 2^ 1^ 3^ |
    | 3 3 6 5 |
    | 2 6_ 2 1 |
    | 1 6_ 1 2 |
}

/* Pentatonic Variation 1 (Var1) */
Var1 {
    <8*>
    | 6_ 3_ 6_ 6_ 2 6_ 2 1 |
    | 5 5 1^ 2^ 2^ 2^ 2^ 6 |
    | 2^ 2^ 5^ 5^ 5^ 6^ 6^ 6^ |
    | 3 5 3 6 3 5 2 6_ |
    | 5^ 3^ 6^ 6^ 6^ 3^ 2^ 3^ |
    | 3 1 6_ 3_ 5_ 1 1 1 |
    | 6 2^ 3^ 3^ 6^ 6^ 6^ 6^ |
    | 1^ 3^ 2^ 1^ 2^ 5^ 6^ 5^ |
}

/* Pentatonic Variation 2 (Var2) */
Var2 {
    <16*>
    | 3 1 3 6  5 3 3 2  2 6_ 5_ 3_  6_ 5_ 5_ 1 |
    | 1^ 6 3 1  3 2 2 6_  2 6_ 5_ 6_  2 1 2 6_ |
    | 2 1 1 3  3 1 2 6_  2 6_ 1 1  5_ 5_ 3_ 5_ |
    | 3^ 6^ 5^ 6^  6^ 5^ 2^ 5^  6^ 3^ 6^ 5^  6^ 6^ 3^ 3^ |
    | 1^ 5 5 3  3 1 2 2  6_ 5_ 2_ 2_  3_ 5_ 2_ 6__ |
    | 3 3 2 3  3 5 3 5  2 2 3 2  2 6_ 5_ 2_ |
    | 5 5 6 2^  5^ 6^ 5^ 2^  2^ 5^ 2^ 5^  6^ 6^ 6^ 6^ |
    | 1^ 5 5 3  2 6_ 2 6_  2 6_ 3_ 5_  1 5_ 6_ 1 |
}

/* Concrete Pentatonic Intro & Outro */
intro:Cello@|0|{
    <4*>
    | 6__ - - - | 1_ - - - |
}

outro:Cello@|0|{ <1*> 6__--- | }
outro:Violin1@|0|{ <1*> 6--- | }
outro:Violin2@|0|{ <1*> 1--- | }
outro:Violin3@|0|{ <1*> 3--- | }

/* S-Expression Playback Flow: Mirror Canon (Inversion / 倒影鏡像卡農) */
-> intro
-> (layer
     (play (Theme Var1 Var2) Violin1)
     (play (flip (Theme Var1 Var2)) Violin2)
     (loop Bass Cello 3))
-> outro
->#
