::SCORE::
** Crab Canon in D **
~ "composer: CanonGenerator (Pentatonic Algorithmic Engine)"
~ "style: 宮調式 (Major Pentatonic), Form: Crab Canon / Cancrizans (螃蟹卡農 / 逆行卡農)"
!= 96
?= D
<4/4>

/* Pentatonic Ground Bass Prototype (Basso Ostinato) */
Bass {
    <4*>
    | 1_ - - - | 5__ - - - |
    | 6__ - - - | 3__ - - - |
    | 2__ - - - | 1__ - - - |
    | 5__ - - - | 1_ - - - |
}

/* Pentatonic Variation 0 (Theme) */
Theme {
    <4*>
    | 1 5_ 6_ 1 |
    | 2 1 1 6_ |
    | 6 5 3 2 |
    | 5_ 6_ 6_ 6_ |
    | 2_ 2_ 3_ 3_ |
    | 1 2 5 5 |
    | 5 3 5 1^ |
    | 5 2 3 5 |
}

/* Pentatonic Variation 1 (Var1) */
Var1 {
    <8*>
    | 5 3 2 5 3 1 5_ 5_ |
    | 5_ 1 1 6_ 2 1 1 5_ |
    | 3 3 5 3 2 3 1 6_ |
    | 3_ 6_ 3_ 6_ 3_ 5_ 2_ 1_ |
    | 6_ 5_ 5_ 6_ 6_ 1 2 5 |
    | 5_ 5_ 6_ 3_ 2_ 3_ 2_ 1_ |
    | 5 3 5 5 2 3 6 2^ |
    | 3 1 2 3 3 3 1 1 |
}

/* Pentatonic Variation 2 (Var2) */
Var2 {
    <16*>
    | 1^ 5 6 1^  1^ 3^ 2^ 1^  6 1^ 2^ 5^  5^ 3^ 6^ 1^^ |
    | 1 1 5_ 5_  3_ 2_ 2_ 1_  1_ 1_ 1_ 3_  5_ 1 6_ 3_ |
    | 1 1 6_ 3_  3_ 3_ 5_ 6_  3_ 5_ 5_ 5_  3_ 3_ 1_ 3_ |
    | 3_ 1_ 1_ 2_  1_ 2_ 2_ 1_  1_ 3_ 2_ 2_  3_ 5_ 1 1 |
    | 6_ 6_ 6_ 2  3 3 5 2  5 2 5 5  1^ 6 1^ 2^ |
    | 5_ 3_ 3_ 3_  5_ 5_ 6_ 5_  3_ 2_ 3_ 2_  1_ 1_ 1_ 1_ |
    | 5 1^ 2^ 2^  3^ 3^ 3^ 6^  1^^ 1^^ 1^^ 1^^  6^ 5^ 1^^ 5^ |
    | 1^ 3^ 2^ 1^  6 2^ 6 5  6 1^ 2^ 2^  5^ 6^ 1^^ 1^^ |
}

/* Concrete Pentatonic Intro & Outro */
intro:Cello@|0|{
    <4*>
    | 1_ - - - | 5__ - - - |
}

outro:Cello@|0|{ <1*> 1_--- | }
outro:Violin1@|0|{ <1*> 1^--- | }
outro:Violin2@|0|{ <1*> 5--- | }
outro:Violin3@|0|{ <1*> 3--- | }

/* S-Expression Playback Flow: Crab Canon (Cancrizans / 螃蟹卡農) */
-> intro
-> (layer
     (play (Theme Var1 Var2) Violin1)
     (play (reverse (Theme Var1 Var2)) Violin2)
     (loop Bass Cello 3))
-> outro
->#
