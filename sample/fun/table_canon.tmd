::SCORE::
** Table Canon in G **
~ "composer: CanonGenerator (Pentatonic Algorithmic Engine)"
~ "style: 宮調式 (Major Pentatonic), Form: Table Canon / Retrograde Inversion (桌子卡農 / 雙倒影逆行卡農)"
!= 96
?= G
<4/4>

/* Pentatonic Ground Bass Prototype (Basso Ostinato) */
Bass {
    <4*>
    | 1_ - - - | 2_ - - - |
    | 3_ - - - | 5_ - - - |
    | 6_ - - - | 5_ - - - |
    | 3_ - - - | 2_ - - - |
}

/* Pentatonic Variation 0 (Theme) */
Theme {
    <4*>
    | 1^ 3^ 1^ 1^ |
    | 6 3 3 2 |
    | 3^ 3^ 3^ 6^ |
    | 5^ 3^ 2^ 1^ |
    | 3^ 2^ 1^ 1^ |
    | 5^ 2^ 2^ 6 |
    | 3 5 2 2 |
    | 5 1^ 1^ 6 |
}

/* Pentatonic Variation 1 (Var1) */
Var1 {
    <8*>
    | 5 5 6 6 6 5 5 5 |
    | 2^ 1^ 1^ 3^ 5^ 3^ 6^ 3^ |
    | 3^ 2^ 5^ 6^ 1^^ 6^ 6^ 1^^ |
    | 5^ 2^ 3^ 2^ 3^ 2^ 2^ 2^ |
    | 6 2^ 2^ 6 3 2 3 2 |
    | 1^ 6 2^ 5^ 1^^ 1^^ 1^^ 5^ |
    | 1^ 1^ 1^ 1^ 6 6 5 2 |
    | 2^ 3^ 1^ 3^ 6^ 5^ 2^ 5^ |
}

/* Pentatonic Variation 2 (Var2) */
Var2 {
    <16*>
    | 1^ 2^ 3^ 1^  6 3 1 5_  1 2 2 2  5 5 6 5 |
    | 2 6_ 5_ 1  1 2 2 3  2 2 6_ 2  2 5 5 1^ |
    | 3 5 2 3  5 1^ 3^ 1^  5 3 6 2^  6 5 2 1 |
    | 5 6 6 5  3 3 5 5  1^ 5 6 3  6 5 5 2 |
    | 6^ 1^^ 1^^ 1^^  1^^ 6^ 3^ 6^  3^ 6^ 1^^ 5^  1^^ 1^^ 1^^ 6^ |
    | 2^ 2^ 3^ 6^  1^^ 1^^ 1^^ 6^  1^^ 1^^ 5^ 3^  1^ 2^ 2^ 5^ |
    | 3^ 3^ 6^ 1^^  6^ 6^ 6^ 1^^  5^ 2^ 5^ 2^  6 3 5 6 |
    | 6 6 3 1  2 3 6 2^  6 6 3 2  5 3 3 3 |
}

/* Concrete Pentatonic Intro & Outro */
intro:Cello@|0|{
    <4*>
    | 1_ - - - | 2_ - - - |
}

outro:Cello@|0|{ <1*> 1_--- | }
outro:Violin1@|0|{ <1*> 1^--- | }
outro:Violin2@|0|{ <1*> 5--- | }
outro:Violin3@|0|{ <1*> 3--- | }

/* S-Expression Playback Flow: Table Canon (Tafelkanon / 雙倒影逆行桌子卡農) */
-> intro
-> (layer
     (play (Theme Var1 Var2) Violin1)
     (play (flip (reverse (Theme Var1 Var2))) Violin2)
     (loop Bass Cello 3))
-> outro
->#
