::SCORE::
** Baroque Tonal Canon in D **
~ "composer: CanonGenerator (Tonal Algorithmic Engine)"
~ "style: 自然大調 (Diatonic Major / Functional Tonal), Form: Standard Polyphonic Canon (輪唱卡農)"
!= 96
?= D
<4/4>

/* Tonal Functional Ground Bass Prototype (Basso Ostinato) */
Bass {
    <4*>
    | 1_ - - - | 5__ - - - |
    | 6__ - - - | 3__ - - - |
    | 4__ - - - | 1__ - - - |
    | 4__ - - - | 5__ - - - |
}

/* Pentatonic Variation 0 (Theme) */
Theme {
    <4*>
    | 5 - 6 7 |
    | 5_ - - 5_ |
    | 6_ - 5_ - |
    | 5_ - - 5_ |
    | 6_ - 6_ 1 |
    | 1 - - 1 |
    | 6_ - 1 6_ |
    | 7_ 1 - 6_ |
}

/* Pentatonic Variation 1 (Var1) */
Var1 {
    <8*>
    | 1 - 3 2 7_ 5_ 5_ 3_ |
    | 0 5_ 5_ 4_  6_ - 5_ 5_ |
    | 3 - 3  4 - 3  2 3 |
    | 5_ - 4_  5_ - 4_  6_ 4_ |
    | 0 1 6_ 7_  5_ - 3_ 4_ |
    | 5_ - 5_ 6_ 6_ 7_ 1 3 |
    | 4 - 4  5 - 3  2 3 |
    | 7_ - 5_ 7_ 5_ 4_ 5_ 5_ |
}

/* Pentatonic Variation 2 (Var2) */
Var2 {
    <16*>
    | 5 - - -  7 2^ 4^ 5^  3^ 4^ 5^ 5^  5^ 3^ 3^ 5^ |
    | 6 7 7 2^  1^ - - -  7 6 7 1^  3^ 3^ 2^ 4^ |
    | 6 1^ 1^ 6  6 5 4 4  0 0 2 6_  7_ 6_ 4_ 6_ |
    | 4_ 2_ 2_ 3_  3_ - - -  2_ 1_ 1_ 1_  2_ 3_ 1_ 2_ |
    | 4_ 2_ 4_ 3_  2_ 1_ 1_ 2_  0 0 1_ 1_  2_ 2_ 1_ 1_ |
    | 1 - - -  1 2 3 5  5 6 4 4  4 6 7 7 |
    | 6_ 4_ 6_ 4_  6_ 6_ 1 7_  0 0 1 5_  2 1 6_ 5_ |
    | 7_ 1 7_ 6_  5_ 6_ 5_ 4_  0 0 2_ 1_  1_ 1_ 2_ 1_ |
}

/* Pentatonic Variation 3 (Var3) */
Var3 {
    <8*>
    | 1^ 0 1^ 0 2^ 0 2^ 0 |
    | 5 0 7 0 2^ 0 3^ 0 |
    | 6_ - 0 6_  1 - 0 1 |
    | 0 7_  0 2  0 4  3 - |
    | 4_ 0 6_ 0 4_ 0 3_ 0 |
    | 3_ 0 3_ 0 5_ 0 6_ 0 |
    | 0 6_  0 1  0 2  1 - |
    | 5 - 0 5  4 - 0 4 |
}

/* Concrete Pentatonic Intro & Outro */
intro:Cello@|0|{
    <4*>
    | 1_ - - - | 5__ - - - |
}

outro:Cello@|0|{ <1*> 1_--- | }
outro:Violin1@|0|{ <1*> 1^--- | }
outro:Violin2@|0|{ <1*> 5--- | }
outro:Violin3@|0|{ <1*> 3--- | }

/* S-Expression Playback Flow: Standard Polyphonic Canon (輪唱卡農) */
-> intro
-> (layer
     (canon (Theme Var1 Var2 Var3) (Violin1 Violin2 Violin3) 2)
     (loop Bass Cello 5))
-> outro
->#
