::SCORE::
** Baroque Canon in D **
~ "composer: CanonGenerator (Tonal Algorithmic Engine)"
~ "style: 自然大調 (Diatonic Major / Functional Tonal), Form: Standard Polyphonic Canon (輪唱卡農)"
!= 64
?= D
<4/4>

/* Tonal Functional Ground Bass Prototype (Basso Ostinato) */
Bass {
    <4*>
    | 1_ - - - | 5__ - - - |
    | 6__ - - - | 3__ - - - |
    | 4__ - - - | 1__ - - - |
    | 4__ - - - | 5__ - - - |
}

/* Pentatonic Variation 0 (Theme) */
Theme {
    <4*>
    | 1^ - 3^ - |
    | 5 6 - 1^ |
    | 6 - 4 - |
    | 7_ - 2 3 |
    | 1 2 - 1 |
    | 5_ 6_ - 1 |
    | 6_ - - 6_ |
    | 7_ - 7_ 2 |
}

/* Pentatonic Variation 1 (Var1) */
Var1 {
    <8*>
    | 1 - 3 5 3 3 1 6_ |
    | 2 - 1 - 2 7_ 2 4 |
    | 6 - 7 - 7 5 3 4 |
    | 3_ - 2_  2_ - 4_  4_ 4_ |
    | 6_ - 5_ 5_ 6_ 1 1 7_ |
    | 1_ - 1_ 1_ 2_ 3_ 5_ 3_ |
    | 6_ - 4_  5_ - 4_  2_ 4_ |
    | 5_ - 4_  3_ - 2_  1_ 2_ |
}

/* Pentatonic Variation 2 (Var2) */
Var2 {
    <16*>
    | 3 2 1 7_  6_ 6_ 1 2  0 0 7_ 1  2 7_ 1 1 |
    | 5 4 5 4  5 7 1^ 6  0 0 7 2  5 4 2 2 |
    | 1 2 1 6_  7_ - - -  7_ 6_ 1 1  6_ 5_ 4_ 5_ |
    | 3 3 1 2  7_ - - -  2 4 2 3  3 2 1 7_ |
    | 4 4 2 3  1 6_ 7_ 5_  0 0 4_ 6_  3_ 4_ 4_ 6_ |
    | 3_ 1_ 1_ 1_  1_ 1_ 1_ 1_  0 0 2_ 1_  1_ 2_ 3_ 1_ |
    | 6_ 5_ 4_ 3_  4_ 4_ 3_ 5_  0 0 5_ 3_  5_ 3_ 3_ 3_ |
    | 5 7 2^ 1^  6 5 5 4  0 0 3 1  2 7_ 6_ 1 |
}

/* Concrete Pentatonic Intro & Outro */
intro:Cello@|0|{
    <4*>
    | 1_ - - - | 5__ - - - |
}

outro:Cello@|0|{ <1*> 1_--- | }
outro:Violin1@|0|{ <1*> 1^--- | }
outro:Violin2@|0|{ <1*> 5--- | }
outro:Violin3@|0|{ <1*> 3--- | }

/* S-Expression Playback Flow: Standard Polyphonic Canon (輪唱卡農) */
-> intro
-> (layer
     (canon (Theme Var1 Var2) (Violin1 Violin2 Violin3) 2)
     (loop Bass Cello 4))
-> outro
->#
