::SCORE::
** zonble's weird stuff **
!= 120
?= Am
<4/4>

theme {
    <8*>
    | 1 2 1 3 1 4 1 5|
}
quick_theme {
    <8*>
    | 1 2 1 3 1 4 1 5|
}
fire {
  <16 *>
  | 1_ 2_ 3_ 4_ 5_ 6_ 7_ 7_ 1 2 3 4 5 6 7 7|
}

bass {
    <8*>
    |1_ - 1_ - 1_ - 1_ - |
}
quick_bass {
    <8*>
    |1_ - 1_ - 1_ - 1_ - |
}

end:Piano@|0| {
<1*>
| 1 |
}

-> (loop theme Piano1 2)
-> (loop (vary (reverse theme) (octave 1)) Piano2 2)
-> (layer 
    (loop theme Piano1 4)
    (loop (vary (reverse theme) (octave 1)) Piano2 4)
    (loop bass Piano3 4)
    )
-> {?+1}
-> (layer 
    (loop theme Piano1 4)
    (loop (vary (reverse theme) (octave 1)) Piano2 4)
    (loop bass Piano3 4)
    (loop fire Piano4 4)
    )
-> {?+1}
-> (layer 
    (loop quick_theme Piano1 2)
    (loop (vary (reverse quick_theme) (octave 1)) Piano2 2)
    (loop quick_bass Piano3 2)
    (loop fire Piano4 2)
    (loop (reverse fire) Piano5 2)
    )
-> {?+1}
-> (layer 
    (loop quick_theme Piano1 2)
    (loop (vary (reverse quick_theme) (octave 1)) Piano2 2)
    (loop quick_bass Piano3 2)
    (loop fire Piano4 2)
    (loop (reverse fire) Piano5 2)
    )
->end
-> #
