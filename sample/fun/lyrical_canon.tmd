::SCORE::
** Lyrical Canon in D **
~ "composer: CanonGenerator (Pentatonic Algorithmic Engine)"
~ "style: 宮調式 (Major Pentatonic), Form: Standard Polyphonic Canon (輪唱卡農)"
!= 96
?= D
<4/4>

/* Pentatonic Ground Bass Prototype (Basso Ostinato) */
Bass {
    <4*>
    | 1_ - - - | 5__ - - - |
    | 6__ - - - | 3__ - - - |
    | 2__ - - - | 1__ - - - |
    | 5__ - - - | 1_ - - - |
}

/* Pentatonic Variation 0 (Theme) */
Theme {
    <4*>
    | 5 - 6 1^ |
    | 5_ - - 5_ |
    | 6_ - 5_ - |
    | 5_ - - 5_ |
    | 5_ - 5_ 1 |
    | 1 - - 1 |
    | 2 - 5 2 |
    | 3 5 - 2 |
}

/* Pentatonic Variation 1 (Var1) */
Var1 {
    <8*>
    | 1 - 3 2 6_ 3_ 3_ 1_ |
    | 0 5_ 5_ 3_  6_ - 5_ 5_ |
    | 3 - 3  5 - 3  2 3 |
    | 5_ - 3_  5_ - 3_  6_ 3_ |
    | 0 6_ 3_ 5_  2_ - 1_ 2_ |
    | 5_ - 5_ 6_ 6_ 1 2 5 |
    | 1 - 1  2 - 6_  5_ 6_ |
    | 3 - 1 3 1 6_ 1 1 |
}

/* Pentatonic Variation 2 (Var2) */
Var2 {
    <16*>
    | 5 - - -  1^ 3^ 6^ 1^^  5^ 6^ 1^^ 1^^  1^^ 5^ 5^ 1^^ |
    | 2 3 3 6  5 - - -  3 2 3 5  1^ 1^ 6 2^ |
    | 6 2^ 2^ 6  6 5 3 3  0 0 1 3_  5_ 3_ 1_ 3_ |
    | 3_ 1_ 1_ 2_  2_ - - -  1_ 1_ 1_ 1_  2_ 3_ 1_ 2_ |
    | 2_ 1_ 3_ 2_  1_ 1_ 1_ 2_  0 0 1_ 1_  2_ 2_ 1_ 1_ |
    | 1 - - -  1 2 3 6  6 1^ 5 5  5 1^ 2^ 2^ |
    | 2 6_ 2 6_  2 2 5 3  0 0 5 1  6 5 2 1 |
    | 3 5 3 2  1 2 1 6_  0 0 3_ 1_  2_ 2_ 3_ 1_ |
}

/* Pentatonic Variation 3 (Var3) */
Var3 {
    <8*>
    | 1^ 0 1^ 0 2^ 0 2^ 0 |
    | 1 0 3 0 6 0 1^ 0 |
    | 6_ - 0 6_  2 - 0 2 |
    | 0 1  0 3  0 6  5 - |
    | 2_ 0 5_ 0 2_ 0 1_ 0 |
    | 3_ 0 3_ 0 6_ 0 1 0 |
    | 0 2  0 5  0 6  5 - |
    | 1^ - 0 1^  6 - 0 6 |
}

/* Concrete Pentatonic Intro & Outro */
intro:Cello@|0|{
    <4*>
    | 1_ - - - | 5__ - - - |
}

outro:Cello@|0|{ <1*> 1_--- | }
outro:Violin1@|0|{ <1*> 1^--- | }
outro:Violin2@|0|{ <1*> 5--- | }
outro:Violin3@|0|{ <1*> 3--- | }

/* S-Expression Playback Flow: Standard Polyphonic Canon (輪唱卡農) */
-> intro
-> (layer
     (canon (Theme Var1 Var2 Var3) (Violin1 Violin2 Violin3) 2)
     (loop Bass Cello 5))
-> outro
->#
