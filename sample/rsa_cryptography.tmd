::SCORE::
** RSA: The Asymmetric Cipher Symphony **
!= 124
?= C
<4/4>

/* ==============================================================================
 * 【RSA 密碼學演算法與音樂映射原理】
 *
 * RSA (Rivest–Shamir–Adleman, 1977) 是現代公鑰密碼學的基石，其安全性建立在
 * 「大整數質因數分解在計算上的極度困難性」（Trapdoor One-Way Function）。
 *
 * 1. 金鑰生成（Key Generation）：
 *    - 選定兩個互質的質數：p = 5, q = 7。
 *    - 計算模數（Modulus）：N = p * q = 35。所有運算都在同餘環 Z/35Z 進行。
 *    - 計算歐拉函數（Euler's Totient）：φ(N) = (p - 1)(q - 1) = 4 * 6 = 24。
 *    - 選擇公開加密指數 e：必須與 φ(N) 互質，選 e = 5 (gcd(5, 24) = 1)。
 *    - 透過擴展歐幾里得演算法求私鑰解密指數 d（模反元素）：
 *      e * d ≡ 1 (mod 24)  ===>  5 * 5 = 25 ≡ 1 (mod 24)  ===>  d = 5。
 *
 * 2. 明文動機（Plaintext M）：
 *    - 選取原創五聲音階明亮動機：M = [1, 2, 3, 5] (C, D, E, G)。
 *
 * 3. 模冪加密（Modular Exponentiation Encryption: C ≡ M^e mod N）：
 *    - M = 1  ===>  1^5 mod 35 = 1       ≡ 1 (C)
 *    - M = 2  ===>  2^5 = 32 mod 35 = 32 ≡ 32 mod 12 = 8 (Ab / b6)
 *    - M = 3  ===>  3^5 = 243 mod 35 = 33 ≡ 33 mod 12 = 9 (A / 6)
 *    - M = 5  ===>  5^5 = 3125 mod 35 = 10 ≡ 10 mod 12 = 10 (Bb / b7)
 *    - 原本和諧的明文 [1, 2, 3, 5]，瞬間被加密為看似無調性、混沌的密文 [1, b6, 6, b7]！
 *
 * 4. 陷門解密（Trapdoor Decryption: M ≡ C^d mod N）：
 *    - 根據歐拉定理，任何握有私鑰 d = 5 的人，皆可進行模冪逆運算：
 *      C^d ≡ (M^e)^d ≡ M^(e*d) ≡ M^(k*φ(N) + 1) ≡ M (mod N)
 *    - [1, 32, 33, 10]^5 mod 35 分毫不差地 100% 還原為最初的明文 [1, 2, 3, 5]！
 *
 * 音樂結構：
 * Movement I   : 質數 p 與 q 的對位誕生 (Keygen)
 * Movement II  : 宣讀明文，純樸優美的 C 大調旋律 (Plaintext)
 * Movement III : 公鑰加密，墜入混亂無調性的同餘密文迷宮 (Ciphertext)
 * Movement IV  : 私鑰陷門插入，逆運算和聲收束 (Trapdoor Decryption)
 * Movement V   : 明文重生，數學還原的奇蹟再現 (Resolved)
 * ============================================================================== */

/* ==========================================================
 * Movement I: Keygen (質數 p=5 與 q=7 的誕生)
 * 大提琴與低音提琴演奏質數音程，宣告基礎模數空間 N = p * q = 35
 * ========================================================== */
keygen:Cello@|-1|{
    <4*>
    /* 質數 p=5 的低音律動 */
    5 - - - | 5 - 5 - |
    /* 質數 q=7 的對位交織 */
    7 - - - | 7 - 7 - |
}

keygen:Bass@|-2|{
    <2*>
    /* 乘積模數 N=35 的沈重低音脈衝 (3 5) */
    3 5 | 3 5 |
    3 5 | 3 5 |
}

/* ==========================================================
 * Movement II: Plaintext M (明文：未加密的純樸旋律)
 * 小提琴奏出乾淨、明亮、清晰的 C 大調原創動機 M = [1 2 3 5]
 * ========================================================== */
plaintext:Violin@|+1|{
    <4*>
    1 2 3 5 | 3 2 1 - |
    1 2 3 5 | 6 5 3 - |
    2 3 5 6 | 5 3 2 - |
    1 2 3 5 | 3 2 1 - |
}

plaintext:Piano@|0|{
    <4*>
    /* 純淨的大調三和弦伴奏 */
    [1 3 5] - - - | [4 6 1] - - - |
    [1 3 5] - - - | [5 7 2] - - - |
    [2 4 6] - - - | [5 7 2] - - - |
    [1 3 5] - - - | [1 3 5] - - - |
}

/* ==========================================================
 * Movement III: Encryption C = M^e mod N (公鑰加密)
 * 公鑰 e = 5 介入！透過模冪運算，明文瞬間被打碎成密文：
 * M=[1 2 3 5] ---> C=[1 b6 6 b7]
 * 進入無調性、充滿張力與焦慮的密文迷宮
 * ========================================================== */
ciphertext:Violin@|+1|{
    <4*>
    /* 密文 C = [1 6, 6 7,] 詭異音列登場 */
    1 6, 6 7, | 6 6, 1 - |
    1 6, 6 7, | 4' 6, 6 - |
    6, 6 7, 4' | 7, 6 6, - |
    1 6, 6 7, | 6 6, 1 - |
}

ciphertext:Piano@|0|{
    <8*>
    /* 密碼學混沌碎形伴奏：減五度與半音群摩擦 */
    1 4' 1 4'  6, 2 6, 2 | 6 3, 6 3,  7, 3 7, 3 |
    1 4' 1 4'  6, 2 6, 2 | 6 3, 6 3,  7, 3 7, 3 |
    1 4' 1 4'  6, 2 6, 2 | 6 3, 6 3,  7, 3 7, 3 |
    1 4' 1 4'  6, 2 6, 2 | 6 3, 6 3,  1 - - - |
}

/* ==========================================================
 * Movement IV: Decryption Trapdoor d (私鑰陷門與數學解密)
 * 私鑰 d = 5 插入！歐拉函數倒轉同餘時鐘，鋼琴帶領管弦樂逆算還原
 * ========================================================== */
trapdoor:Piano@|0|{
    <4*>
    /* 模反元素逆運算：和聲逐漸從混亂中收束對齊 */
    [6, 1 4'] - [6 1 3] - | [7, 2 4] - [5 7 2] - |
    [6, 1 4'] - [6 1 3] - | [5 7 2] - - - |
}

trapdoor:Cello@|-1|{
    <4*>
    /* 低音部鎖定主音，準備破繭而出 */
    6, - 6 - | 7, - 5 - |
    6, - 6 - | 5 - - - |
}

/* ==========================================================
 * Movement V: Decrypted Plaintext Restored (明文重生，數學的奇蹟)
 * 密文在經過私鑰解算後，分毫不差地還原回最初的明文主題！
 * ========================================================== */
resolved:Violin@|+1|{
    <4*>
    /* 完美重現 Movement II 的明文 [1 2 3 5]！ */
    1 2 3 5 | 3 2 1 - |
    1 2 3 5 | 6 5 3 - |
    2 3 5 6 | 5 3 2 - |
    1 2 3 5 | 3 2 1 - |
}

resolved:Piano@|0|{
    <4*>
    [1 3 5] - [4 6 1] - | [1 3 5] - - - |
    [1 3 5] - [5 7 2] - | [1 3 5] - - - |
    [4 6 1] - [5 7 2] - | [1 3 5] - - - |
    [1 3 5 1] - - - | - - - - |
}

resolved:Cello@|-1|{
    <4*>
    1 - 4 - | 1 - - - |
    1 - 5 - | 1 - - - |
    4 - 5 - | 1 - - - |
    1 - - - | - - - - |
}

/* ==========================================================
 * 全曲宏觀結構進行：
 * 金鑰生成 -> 宣讀明文 -> 公鑰加密(混亂) -> 私鑰解密(陷門) -> 明文再現
 * ========================================================== */
-> keygen
-> plaintext
-> ciphertext
-> trapdoor
-> resolved ->#
