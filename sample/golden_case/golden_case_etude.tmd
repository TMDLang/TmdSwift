    -> (canon EtudeProto (PianoRH PianoLH) 1)
    -> (play (vary EtudeProto +7 flip reverse) PianoRH)
    -> Var_Staggered
    -> Var_LexerCrunch
    -> Var_TupletLab
    -> Var_NanoMeter
    -> Var_LeadingTie
    -> Var_StereoHocket
    -> Var_Bitonality
    -> Var_ThreeHandEffect
