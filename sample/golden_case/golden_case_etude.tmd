/* 7.5. 混沌極限亂轉調狂想曲 (Var_ChaoticModulation)：小節內每拍每音換調、雙手反向轉調、質數級進與柯川步進 */
Var_ChaoticModulation:PianoRH@|0|{
    <16*>
    /* Bar 1: 十二音列每兩音絕對轉調 (12-Tone Serial Instant Key Shift: C -> C# -> D -> Eb -> E -> F -> F# -> G) */
    | {?=C} 1 3 {?=C'} 1 3 {?=D} 1 3 {?=E,} 1 3 {?=E} 1 3 {?=F} 1 3 {?=F'} 1 3 {?=G} 1 3 |
    /* Bar 2: 柯川步進三度增和弦矩陣 (Coltrane / Giant Steps Augmented Matrix: B -> G -> Eb -> B) */
    | {?=B} 1 3 5 7^ {?=G} 1 3 5 7^ {?=E,} 1 3 5 7^ {?=B} 1 3 5 7^ |
    /* Bar 3: 右手半音步步高升相對轉調 (RH Chromatic Semitone Ascent: +1 -> +1 -> +1 -> +1) */
    | {?+1} 1^ 3^ 5^ 1^^ {?+1} 1^ 3^ 5^ 1^^ {?+1} 1^ 3^ 5^ 1^^ {?+1} 1^ 3^ 5^ 1^^ |
    /* Bar 4: 三全音對稱震盪 (Tritone Pendulum Oscillation: +6 -> -6 -> +6 -> -6) */
    | {?+6} 1 3, 5 1^ {?-6} 1 3, 5 1^ {?+6} 1 3, 5 1^ {?-6} 1 3, 5 1^ |
    /* Bar 5: 質數級進轉調螺旋 (Prime Step Modulation Spiral: +2 -> +3 -> +5 -> +7) */
    | {?+2} 1 3 5 1^ {?+3} 1 3 5 1^ {?+5} 1 3 5 1^ {?+7} 1 3 5 1^ |
    /* Bar 6: 完全混沌隨機大跳 (Total Entropy Jump: +11 -> -9 -> +8 -> -11) */
    | {?+11} 1 2 3 5 {?-9} 1 2 3 5 {?+8} 1 2 3 5 {?-11} 1 2 3 5 |
    /* Bar 7: 全調性終止狂潮 (Omni-tonal Cadential Cascade: A' -> D, -> G, -> B) */
    | {?=A'} 1 3 5 1^ {?=D,} 1 3 5 1^ {?=G,} 1 3 5 1^ {?=B} 1 3 5 1^ |
    /* Bar 8: 回歸 C 小調引爆終結 (Convergence back to C minor) */
    | {?=C} {key= Cm} 1 3, 5 1^ 7 5 3, 1 1_+3,+5+1 - - - - - - - |
}

Var_ChaoticModulation:PianoLH@|0|{
    <16*>
    /* Bar 1: 十二音列低音逆行倒影支撐 (Counter-Serial Bass: G# -> G -> F# -> F -> E -> Eb -> D -> C#) */
    | {?=G'} 1_ 5_ {?=G} 1_ 5_ {?=F'} 1_ 5_ {?=F} 1_ 5_ {?=E} 1_ 5_ {?=E,} 1_ 5_ {?=D} 1_ 5_ {?=C'} 1_ 5_ |
    /* Bar 2: 柯川步進低音支撐 (Coltrane Bass Foundations: B -> G -> Eb -> B) */
    | {?=B} 1__ 5__ 1_ 3_ {?=G} 1__ 5__ 1_ 3_ {?=E,} 1__ 5__ 1_ 3_ {?=B} 1__ 5__ 1_ 3_ |
    /* Bar 3: 左手半音步步下降對稱轉調 (LH Chromatic Semitone Descent: -1 -> -1 -> -1 -> -1) */
    | {?-1} 1__ 5__ 1_ 5_ {?-1} 1__ 5__ 1_ 5_ {?-1} 1__ 5__ 1_ 5_ {?-1} 1__ 5__ 1_ 5_ |
    /* Bar 4: 三全音對稱反向低音 (Tritone Pendulum Counter Bass: -6 -> +6 -> -6 -> +6) */
    | {?-6} 1__ 5__ 1_ 5_ {?+6} 1__ 5__ 1_ 5_ {?-6} 1__ 5__ 1_ 5_ {?+6} 1__ 5__ 1_ 5_ |
    /* Bar 5: 質數級進反向螺旋低音 (Prime Step Counter Spiral: -2 -> -3 -> -5 -> -7) */
    | {?-2} 1__ 3__ 5__ 1_ {?-3} 1__ 3__ 5__ 1_ {?-5} 1__ 3__ 5__ 1_ {?-7} 1__ 3__ 5__ 1_ |
    /* Bar 6: 完全混沌低音對抗 (Total Entropy Bass Resistance: -11 -> +9 -> -8 -> +11) */
    | {?-11} 1__ 5__ 1_ 5_ {?+9} 1__ 5__ 1_ 5_ {?-8} 1__ 5__ 1_ 5_ {?+11} 1__ 5__ 1_ 5_ |
    /* Bar 7: 全調性終止狂潮低音 (Omni-tonal Cadential Bass: A' -> D, -> G, -> B) */
    | {?=A'} 1__ 5__ 1_ 3_ {?=D,} 1__ 5__ 1_ 3_ {?=G,} 1__ 5__ 1_ 3_ {?=B} 1__ 5__ 1_ 3_ |
    /* Bar 8: 回歸 C 小調大低音 (Convergence back to C minor pedal) */
    | {?=C} {key= Cm} 1___ 5___ 1__ 3,__ 5__ 1_ 3,_ 5_ 1____+1___+1__ - - - - - - - |
}

/* 8. 舞台多媒體特效腳本區塊與 MIDI 0 / 127 奇異點終極音牆 */
GrandFinale_BlackCluster:FXSciFi@GrandFinale_BlackCluster{
    """
    cue strobe_all_88_keys
    laser_matrix full_spectrum
    pyro_flame_burst angle=90
    blackout_decay 2.0
    """
}

GrandFinale_BlackCluster:PianoRH@|0|{
    <4*>
    | {fff} 1_____+6____+1___+1__+1_+1+1^+1^^+1^^^+1^^^^+5^^^^^ - - - |
}

GrandFinale_BlackCluster:PianoLH@|0|{
    <4*>
    | {fff} 1_____+6____+1___+1__+1_+1+1^+1^^+1^^^+1^^^^+5^^^^^ - - - |
}

