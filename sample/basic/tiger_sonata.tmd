::SCORE::
** 兩隻老虎：奏鳴曲 **

!= 132
?= C
<4/4>

~ "形式：奏鳴曲式"
~ "主題：兩隻老虎"

/* --------------------------------------------------------------------------
   呈示部：第一主題以 C 大調呈現，第二主題移至 G 大調。
   -------------------------------------------------------------------------- */
exposition_primary:Piano@|0|{
    <4*>
    1 2 3 1 | 1 2 3 1 | 3 4 5 - | 3 4 5 - |
    5 6 5 4 | 3 1 5 6 | 1 5_ 1 - | 1 5_ 1 - |
}

exposition_primary:CHORD@|0|{
    <2*>
    [1] - | [5] - | [1] - | [5] - |
    [1] - | [4] - | [1] - | [5] - |
}

exposition_primary:Bass@|0|{
    <4*>
    1_ - 5_ - | 1_ - 5_ - | 1_ - 5_ - | 1_ - 5_ - |
    1_ - 4_ - | 1_ - 5_ - | 1_ - 5_ - | 1_ - 1_ - |
}

exposition_secondary:Piano@|0|{
    <4*>
    5 7 2^ 7 | 6 5 4 - | 3 4 5 6 | 5 - - - |
    6 1^ 7 6 | 5 4 3 - | 2 3 4 5 | 5 - - - |
}

exposition_secondary:CHORD@|0|{
    <2*>
    [5] - | [5] - | [1] - | [1] - |
    [6m] - | [2m] - | [5] - | [5] - |
}

exposition_secondary:Bass@|0|{
    <4*>
    5_ - 5_ - | 5_ - 5_ - | 1_ - 1_ - | 1_ - 1_ - |
    6_ - 6_ - | 2_ - 2_ - | 5_ - 5_ - | 5_ - 5_ - |
}

/* --------------------------------------------------------------------------
   發展部：主題切分、倒影式回應與短暫轉調，保持四小節動機的辨識度。
   -------------------------------------------------------------------------- */
development:Piano@|0|{
    <8*>
    1 2 3 1 2 3 4 5 | 5 4 3 2 1 2 3 4 |
    5 6 5 4 6 5 4 3 | 2 3 4 5 6 5 4 3 |
    3 4 5 3 4 5 6 7 | 1^ 7 6 5 4 3 2 1 |
    2 3 4 2 3 4 5 6 | 7 1^ 7 6 5 4 3 2 |
}

development:CHORD@|0|{
    <2*>
    [1] - | [5] - | [6m] - | [4] - |
    [2m] - | [5] - | [1] - | [5] - |
}

development:Bass@|0|{
    <4*>
    1_ 5_ 1_ 5_ | 6_ 3_ 4_ 1_ |
    2_ 5_ 2_ 5_ | 1_ 5_ 1_ 5_ |
    6_ 3_ 6_ 3_ | 4_ 1_ 4_ 5_ |
    2_ 5_ 2_ 5_ | 1_ - - - |
}

/* --------------------------------------------------------------------------
   再現部：兩個主題都回到 C 大調，第二主題的旋律保留呈示部的輪廓。
   -------------------------------------------------------------------------- */
recapitulation_primary:Piano@|0|{
    <4*>
    1 2 3 1 | 1 2 3 1 | 3 4 5 - | 3 4 5 - |
    5 6 5 4 | 3 1 5 6 | 1 5_ 1 - | 1 5_ 1 - |
}

recapitulation_primary:CHORD@|0|{
    <2*>
    [1] - | [5] - | [1] - | [5] - |
    [1] - | [4] - | [1] - | [5] - |
}

recapitulation_primary:Bass@|0|{
    <4*>
    1_ - 5_ - | 1_ - 5_ - | 1_ - 5_ - | 1_ - 5_ - |
    1_ - 4_ - | 1_ - 5_ - | 1_ - 5_ - | 1_ - 1_ - |
}

recapitulation_secondary:Piano@|0|{
    <4*>
    5 7 2^ 7 | 6 5 4 - | 3 4 5 6 | 5 - - - |
    6 1^ 7 6 | 5 4 3 - | 2 3 4 5 | 1 - - - |
}

recapitulation_secondary:CHORD@|0|{
    <2*>
    [1] - | [5] - | [1] - | [1] - |
    [6m] - | [2m] - | [5] - | [5] - |
}

recapitulation_secondary:Bass@|0|{
    <4*>
    1_ - 1_ - | 5_ - 5_ - | 1_ - 1_ - | 1_ - 1_ - |
    6_ - 6_ - | 2_ - 2_ - | 5_ - 5_ - | 5_ - 5_ - |
}

/* 尾聲以主題的第一句收束，最後兩小節留出明確的終止感。 */
coda:Piano@|0|{
    <4*>
    1 2 3 1 | 3 4 5 - | 5 6 5 4 | 1 - - - |
}

coda:CHORD@|0|{
    <2*>
    [1] - | [5] - | [4] - | [1] - |
}

coda:Bass@|0|{
    <4*>
    1_ - 5_ - | 1_ - 5_ - | 4_ - 5_ - | 1_ - - - |
}

-> exposition_primary -> exposition_secondary -> {?+2} -> development -> {?-2} -> recapitulation_primary -> recapitulation_secondary -> coda ->#