::SCORE::
** Canon in D (Complete Macro Edition) **
~ "composer: Johann Pachelbel"
~ "arranger: Macro S-Expression Edition"
!= 56
?= D
<4/4>

/* ==========================================================================
   Ground Bass Prototype (2 小節固定低音原型)
   ========================================================================== */
Bass {
    <4*>
    1_ 5__ 6__ 3__ | 4__ 1__ 4__ 5__ |
}

/* ==========================================================================
   Authentic Canon Variations (12 Variations + 1 Cadence = 50 小節完整變奏原型群)
   依據 IMSLP / Mutopia Project 原始 3 Violini e Basso 總譜轉寫
   ========================================================================== */

/* Verse 1: 主題陳述 (四分音符莊嚴主題, bars 1-4) */
Theme {
    <4*>
    3^ 2^ 1^ 7 | 6 5 6 7 | 1^ 7 6 5 | 4 3 4 2 |
}

/* Verse 2: 變奏 1 (八分音符級進與跳進, bars 5-8) */
Var1 {
    <8*>
    1 3 5 4 3 1 3 2 | 1 6_ 1 5 4 6 5 4 |
    3 1 2 7 1^ 3^ 5^ 5 | 6 4 5 3 1 1^ (1^ 1^ 1^ 7)%( - - ) |
}

/* Verse 3: 變奏 2 (十六分音符流動旋律, bars 9-12) */
Var2 {
    <16*>
    1^ 7 1^ 1  7_ 5 2 3  1 1^ 7 6  7 3^ 5^ 6^ |
    4^ 3^ 2^ 4^  3^ 2^ 1^ 7  6 5 4 3  2 4 3 2 |
    1 2 3 4  5 2 5 4  3 6 5 4  5 4 3 2 |
    1 6_ 6 7  1^ 7 6 5  4 3 2 6  5 6 5 4 |
}

/* Verse 4: 變奏 3 (跳躍大八度與高位休止, bars 13-16) */
Var3 {
    <8*>
    3 3^ 2^- 0 1^ 3^- |
    6^- 5^- 6^- 7^- |
    1^^ 1^ 7- 0 6 1^- |
    1^-- 1^ 1^ 4^ 2^ 5^ |
}

/* Verse 5: 變奏 4 (三十二分音符激奏琶音, bars 17-20) */
Var4 {
    <32*>
    5^- 3^ 4^ 5^- 3^ 4^ 5 5_ 6_ 7_ 1 2 3 4  3^- 1^ 2^ 3^- 3 4 5 6 5 4 5 3 4 5 |
    4- 6 5 4- 3 2 3 2 1 2 3 4 5 6  4- 6 5 6- 7 1^ 5 6 7 1^ 2^ 3^ 4^ 5^ |
    3^- 1^ 2^ 3^- 2^ 1^ 2^ 7 1^ 2^ 3^ 2^ 1^ 7  1^- 6 7 1^- 1 2 3 4 3 2 3 1^ 7 1^ |
    6- 1^ 7 6- 5 4 5 4 3 4 5 6 7 1^  6- 1^ 7 1^- 7 6 7 1^ 2^ 1^ 7 1^ 6 7 |
}

/* Verse 6: 變奏 5 (斷奏對話與空拍休止, bars 21-24) */
Var5 {
    <8*>
    1^ 0 7 0 6 0 1^ 0 |
    1 0 1 0 1 0 2 0 |
    0 5 0 5 0 3 0 5 |
    0 4 0 3 0 4 0 2^ |
}

/* Verse 7: 變奏 6 (十六分音符交錯織體, bars 25-28) */
Var6 {
    <16*>
    3^ 3 4 3  2 2^ 3^ 2^  1^ 3 1 6  5 5_ 4_ 5_ |
    6_ 6 7 6  5 5_ 4_ 5_  6_ 6 5 6  7 7_ 6_ 7_ |
    1 1^ 2^ 1^  7 7_ 1 7_  6_ 6 5 6  7 7_ 3 2 |
    1 1^ 2^ 4^  3^ 3 5 3^  1^ 4^ 3^ 4^  2^ 5 4 5 |
}

/* Verse 8: 變奏 7 (十六分同音反覆打擊感, bars 29-32) */
Var7 {
    <16*>
    3 5 5 5  5 5 5 5  3 3 3 3  3 3 5 5 |
    4 4 4 1^  1^ 1^ 1^ 1^  1^ 1^ 6 6  5 5 2^ 7 |
    5 3^ 3^ 3^  2^ 2^ 2^ 2^  1^ 1^ 1^ 1^  5^ 5^ 5^ 5^ |
    6^ 6^ 6^ 6^  5^ 5^ 5^ 5^  6^ 6^ 6^ 6^  7^ 7 7 7 |
}

/* Verse 9: 變奏 8 (加花飾音十六分走句, bars 33-36) */
Var8 {
    <16*>
    1^ (1 2)%(-) 3 1  7_ (7 1^)%(-) 2^ 7  6 (6_ 7_)%(-) 1 6_  7_ (5 4)%(-) 3 2 |
    1 (4 3)%(-) 2 4  3 (1 2)%(-) 3 5  4 (6 5)%(-) 4 3  2 (5 4)%(-) 3 2 |
    3 (1^ 7)%(-) 1^ 3  5 (5 6)%(-) 7 5  3 (1^ 2^)%(-) 3^ 1^  3^ (3^ 2^)%(-) 1^ 7 |
    6 (6 5)%(-) 6 7  1^ (3^ 2^)%(-) 1^ 3^  4^ (1^ 7)%(-) 6 6  5 2 5 5 |
}

/* Verse 10: 變奏 9 (附點長音與歌唱性線條, bars 37-40) */
Var9 {
    <16*>
    5----- 5- 1----- 5- |
    4--- 5--- 4- 1- 1-- 7_ |
    1- 1^- 7--- 6--- 5--- |
    1-- 2 3--- 6--- 2-- 2 |
}

/* Verse 11: 變奏 10 (附點切分與下行模進, bars 41-44) */
Var10 {
    <16*>
    3-- 3^ 3^ 4^ 3^ 2^  1^-- 1^ 1^ 2^ 1^ 7 |
    6--- 1^--- 1^ 7, 6 7, 5-- 5 |
    5-- 5^ 5^ 6^ 5^ 4^  3^-- 3^ 3^ 4^ 3^ 2^ |
    1^ 7, 6 7, 5-- 5 4- 1^- 7-- 7 |
}

/* Verse 12: 變奏 11 (高潮切分音與跨八度寬廣跳進, bars 45-48) */
Var11 {
    <16*>
    1^- 1^--- 7--- 6--- 5- |
    5- 4--- 3---- 2 2--- |
    3- 3^--- 2^- 1^- 1^^--- 7,^- |
    6^--- 1^^- 5^- 6^--- 5^--- |
}

/* Verse 13: 變奏 12 (沉降歸結終止式, bars 49-50) */
Var12 {
    <16*>
    5^--- 5-- 4 3--- 3^-- 2^ |
    1^----- 1^- 1^--- 7--- |
}

/* ==========================================================================
   Concrete Sections (前奏與終止尾奏)
   ========================================================================== */

/* 前奏：大提琴先演奏一次 2 小節固定低音鋪陳調性 */
intro:Cello@|0|{
    <4*>
    1_ 5__ 6__ 3__ | 4__ 1__ 4__ 5__ |
}

/* 尾奏：各部匯流終止於 D 大調主三和弦音 */
outro:Violin1@|0|{ <1*> 1^--- | }
outro:Violin2@|0|{ <1*> 3--- | }
outro:Violin3@|0|{ <1*> 1--- | }
outro:Cello@|0|{   <1*> 1_--- | }

/* ==========================================================================
   S-Expression 播放流程 (S-Expression Macro Playback Flow)
   
   全曲 50 小節完整變奏依序串接：
   (Theme Var1 Var2 Var3 Var4 Var5 Var6 Var7 Var8 Var9 Var10 Var11 Var12)
   三把小提琴各間隔 2 小節 (8 拍) 依序卡農進入，總跨度為 54 小節。
   大提琴將 2 小節固定低音 Bass 重複演奏 27 次 (54 小節)。
   最後全體匯流至 outro 圓滿終止。
   ========================================================================== */

-> intro
-> (layer
     (canon (Theme Var1 Var2 Var3 Var4 Var5 Var6 Var7 Var8 Var9 Var10 Var11 Var12) (Violin1 Violin2 Violin3) 2)
     (loop Bass Cello 27))
-> outro
->#
