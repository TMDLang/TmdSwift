{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TMD",
  "scopeName": "source.tmd",
  "patterns": [
    { "include": "#comments" },
    { "include": "#header-root" },
    { "include": "#title" },
    { "include": "#global-settings" },
    { "include": "#orders" },
    { "include": "#paragraph-header" },
    { "include": "#directives" },
    { "include": "#sections" },
    { "include": "#chords" },
    { "include": "#notes" },
    { "include": "#tuplets" },
    { "include": "#ties" },
    { "include": "#barlines" }
  ],
  "repository": {
    "comments": {
      "name": "comment.block.tmd",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "header-root": {
      "match": "::SCORE::",
      "name": "keyword.control.header.tmd"
    },
    "title": {
      "match": "(\\*\\*)([^*]+)(\\*\\*)",
      "captures": {
        "1": { "name": "punctuation.definition.string.begin.tmd" },
        "2": { "name": "entity.name.section.title.tmd" },
        "3": { "name": "punctuation.definition.string.end.tmd" }
      }
    },
    "global-settings": {
      "patterns": [
        {
          "match": "(!\\s*=)\\s*([0-9]+(?:\\.[0-9]+)?)",
          "captures": {
            "1": { "name": "keyword.operator.tempo.tmd" },
            "2": { "name": "constant.numeric.tempo.tmd" }
          }
        },
              {
                "match": "(\\?\\s*=)\\s*([A-Ga-g][',#b]*)",
                "captures": {
                  "1": { "name": "keyword.operator.key.tmd" },
                  "2": { "name": "entity.name.type.key.tmd" }
                }
              },
              {
                "match": "(key\\s*=|Key\\s*=)\\s*([A-Ga-g][#b]?[mM]?)",
                "captures": {
                  "1": { "name": "keyword.operator.declared-key.tmd" },
                  "2": { "name": "entity.name.type.declared-key.tmd" }
                }
              },
        {
          "match": "(<)([0-9]+)/([0-9]+)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.parameters.begin.tmd" },
            "2": { "name": "constant.numeric.beat.count.tmd" },
            "3": { "name": "constant.numeric.beat.note.tmd" },
            "4": { "name": "punctuation.definition.parameters.end.tmd" }
          }
        }
      ]
    },
    "paragraph-header": {
      "match": "([a-zA-Z0-9_\\u4e00-\\u9fa5-]+):([a-zA-Z0-9_\\u4e00-\\u9fa5-]+)(?:@\\|?([+-]?[0-9]+)?\\|?)?\\s*(\\{)",
      "captures": {
        "1": { "name": "entity.name.function.paragraph.tmd" },
        "2": { "name": "variable.parameter.instrument.tmd" },
        "3": { "name": "constant.numeric.offset.tmd" },
        "4": { "name": "punctuation.section.block.begin.tmd" }
      }
    },
    "directives": {
      "patterns": [
              {
                "match": "(\\{)(!=|!\\+)([0-9]+(?:\\.[0-9]+)?)(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.directive.begin.tmd" },
            "2": { "name": "keyword.operator.directive.tempo.tmd" },
            "3": { "name": "constant.numeric.directive.tempo.tmd" },
            "4": { "name": "punctuation.definition.directive.end.tmd" }
                }
              },
              {
                "match": "(\\{)(key\\s*=|Key\\s*=)\\s*([A-Ga-g][#b]?[mM]?)(\\})",
                "captures": {
                  "1": { "name": "punctuation.definition.directive.begin.tmd" },
                  "2": { "name": "keyword.operator.directive.declared-key.tmd" },
                  "3": { "name": "constant.other.directive.declared-key.tmd" },
                  "4": { "name": "punctuation.definition.directive.end.tmd" }
                }
              },
              {
                "match": "(\\{)(ppp|pp|p|mp|mf|f|ff|fff)(\\})",
                "captures": {
                  "1": { "name": "punctuation.definition.directive.begin.tmd" },
                  "2": { "name": "keyword.other.directive.dynamic.tmd" },
                  "3": { "name": "punctuation.definition.directive.end.tmd" }
                }
              },
        {
          "match": "(\\{)(\\?=|[\\?][+-])([A-Ga-g0-9',#b]+)(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.directive.begin.tmd" },
            "2": { "name": "keyword.operator.directive.key.tmd" },
            "3": { "name": "constant.other.directive.key.tmd" },
            "4": { "name": "punctuation.definition.directive.end.tmd" }
          }
        },
        {
          "match": "(\\{)(<)([0-9]+)/([0-9]+)(>)(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.directive.begin.tmd" },
            "2": { "name": "punctuation.definition.parameters.begin.tmd" },
            "3": { "name": "constant.numeric.beat.count.tmd" },
            "4": { "name": "constant.numeric.beat.note.tmd" },
            "5": { "name": "punctuation.definition.parameters.end.tmd" },
            "6": { "name": "punctuation.definition.directive.end.tmd" }
          }
        }
      ]
    },
    "sections": {
      "match": "(<)([0-9]+)(\\*)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.section.begin.tmd" },
        "2": { "name": "constant.numeric.division.tmd" },
        "3": { "name": "keyword.operator.star.tmd" },
        "4": { "name": "punctuation.definition.section.end.tmd" }
      }
    },
    "chords": {
      "match": "(\\[)([^\\]]+)(\\])",
      "captures": {
        "1": { "name": "punctuation.definition.chord.begin.tmd" },
        "2": { "name": "entity.name.tag.chord.tmd" },
        "3": { "name": "punctuation.definition.chord.end.tmd" }
      }
    },
    "notes": {
      "match": "([1-7])([',]?)([_\\^]*)",
      "captures": {
        "1": { "name": "keyword.other.unit.degree.tmd" },
        "2": { "name": "keyword.operator.accidental.tmd" },
        "3": { "name": "storage.modifier.octave.tmd" }
      }
    },
    "tuplets": {
      "patterns": [
        {
          "match": "%\\((-+)\\)",
          "name": "keyword.operator.tuplet.modifier.tmd"
        }
      ]
    },
    "ties": {
      "match": "-",
      "name": "keyword.operator.tie.tmd"
    },
    "barlines": {
      "match": "\\|",
      "name": "punctuation.separator.barline.tmd"
    },
    "orders": {
      "patterns": [
        {
          "match": "->#",
          "name": "keyword.control.order.terminate.tmd"
        },
        {
          "match": "(->)\\s*(\\{[^{}]+\\})",
          "captures": {
            "1": { "name": "keyword.control.order.arrow.tmd" },
            "2": { "name": "keyword.other.order.modulation.tmd" }
          }
        },
        {
          "match": "(->)\\s*([a-zA-Z0-9_\\u4e00-\\u9fa5-]+)",
          "captures": {
            "1": { "name": "keyword.control.order.arrow.tmd" },
            "2": { "name": "entity.name.section.order.name.tmd" }
          }
        }
      ]
    }
  }
}
