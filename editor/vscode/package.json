{
  "name": "tmd-vscode",
  "displayName": "%tmd.displayName%",
  "description": "%tmd.description%",
  "version": "0.1.0",
  "publisher": "zonble",
  "author": "zonble",
  "license": "MIT",
  "homepage": "https://github.com/zonble/TmdSwift",
  "repository": {
    "type": "git",
    "url": "https://github.com/zonble/TmdSwift.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tmd",
    "onLanguage:markdown",
    "onCommand:tmd.openMidiPlayer",
    "onCommand:tmd.openKeyboard",
    "onCommand:tmd.inspectSong",
    "onCommand:tmd.newFromTemplate",
    "onView:tmdKeyboardView",
    "onView:tmdInspectorView"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tmd",
        "aliases": [
          "TMD",
          "tmd"
        ],
        "extensions": [
          ".tmd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tmd",
        "scopeName": "source.tmd",
        "path": "./syntaxes/tmd.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tmd",
        "path": "./snippets/tmd.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "tmd.newFromTemplate",
        "title": "%tmd.commands.newFromTemplate%",
        "category": "TMD",
        "icon": "$(file-add)"
      },
      {
        "command": "tmd.exportMIDI",
        "title": "%tmd.commands.exportMIDI%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.exportMusicXML",
        "title": "%tmd.commands.exportMusicXML%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.exportABC",
        "title": "%tmd.commands.exportABC%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.exportLilyPond",
        "title": "%tmd.commands.exportLilyPond%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.renderPDF",
        "title": "%tmd.commands.renderPDF%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.renderWAV",
        "title": "%tmd.commands.renderWAV%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.exportVSQX",
        "title": "%tmd.commands.exportVSQX%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.exportVSQ",
        "title": "%tmd.commands.exportVSQ%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.exportUST",
        "title": "%tmd.commands.exportUST%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.openMidiPlayer",
        "title": "%tmd.commands.openMidiPlayer%",
        "category": "TMD",
        "icon": "$(play-circle)",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.playAudio",
        "title": "%tmd.commands.playAudio%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.installSkills",
        "title": "%tmd.commands.installSkills%",
        "category": "TMD"
      },
      {
        "command": "tmd.formatDocument",
        "title": "%tmd.commands.formatDocument%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.checkMeasures",
        "title": "%tmd.commands.checkMeasures%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.inspectSong",
        "title": "%tmd.commands.inspectSong%",
        "category": "TMD",
        "icon": "$(pulse)",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.openEmbeddedSnippet",
        "title": "Open TMD Snippet in Editor",
        "category": "TMD"
      },
      {
        "command": "tmd.refactorDoubleGrid",
        "title": "%tmd.commands.refactorDoubleGrid%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorHalveGrid",
        "title": "%tmd.commands.refactorHalveGrid%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorOptimizeGrid",
        "title": "%tmd.commands.refactorOptimizeGrid%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorTranspose",
        "title": "%tmd.commands.refactorTranspose%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorTransposeSelection",
        "title": "%tmd.commands.refactorTransposeSelection%",
        "category": "TMD",
        "enablement": "editorLangId == tmd && editorHasSelection"
      },
      {
        "command": "tmd.refactorDuplicateTrack",
        "title": "%tmd.commands.refactorDuplicateTrack%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorGenerateHarmony",
        "title": "%tmd.commands.refactorGenerateHarmony%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorInlineOrders",
        "title": "%tmd.commands.refactorInlineOrders%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorRenameInstrument",
        "title": "%tmd.commands.refactorRenameInstrument%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorRenameSection",
        "title": "%tmd.commands.refactorRenameSection%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorExtractInstrument",
        "title": "%tmd.commands.refactorExtractInstrument%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.playSection",
        "title": "%tmd.commands.playSection%",
        "category": "TMD",
        "icon": "$(play)"
      },
      {
        "command": "tmd.playTrack",
        "title": "%tmd.commands.playTrack%",
        "category": "TMD",
        "icon": "$(play)"
      },
      {
        "command": "tmd.playCurrentSection",
        "title": "%tmd.commands.playCurrentSection%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.playCurrentTrack",
        "title": "%tmd.commands.playCurrentTrack%",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.openKeyboard",
        "title": "%tmd.commands.openKeyboard%",
        "category": "TMD",
        "icon": "$(piano)"
      },
      {
        "command": "tmd.refreshOutline",
        "title": "%tmd.commands.refreshOutline%",
        "category": "TMD",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tmdStudio",
          "title": "%tmd.viewsContainers.tmdStudio%",
          "icon": "./media/player.svg"
        }
      ]
    },
    "views": {
      "tmdStudio": [
        {
          "type": "webview",
          "id": "tmdKeyboardView",
          "name": "%tmd.views.tmdKeyboardView%"
        },
        {
          "type": "webview",
          "id": "tmdInspectorView",
          "name": "%tmd.views.tmdInspectorView%"
        },
        {
          "id": "tmdOutlineView",
          "name": "%tmd.views.tmdOutlineView%"
        }
      ]
    },
    "menus": {
      "file/newFile": [
        {
          "command": "tmd.newFromTemplate"
        }
      ],
      "explorer/context": [
        {
          "command": "tmd.newFromTemplate",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace@1"
        }
      ],
      "view/title": [
        {
          "command": "tmd.newFromTemplate",
          "when": "view == tmdOutlineView",
          "group": "navigation@1"
        },
        {
          "command": "tmd.refreshOutline",
          "when": "view == tmdOutlineView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "tmd.playSection",
          "when": "view == tmdOutlineView && viewItem == sectionNode",
          "group": "inline"
        },
        {
          "command": "tmd.playTrack",
          "when": "view == tmdOutlineView && viewItem == trackNode",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "tmd.openMidiPlayer",
          "when": "editorLangId == tmd",
          "group": "tmd_preview@1"
        },
        {
          "command": "tmd.exportMIDI",
          "when": "editorLangId == tmd",
          "group": "tmd_export@1"
        },
        {
          "command": "tmd.exportMusicXML",
          "when": "editorLangId == tmd",
          "group": "tmd_export@2"
        },
        {
          "command": "tmd.exportABC",
          "when": "editorLangId == tmd",
          "group": "tmd_export@3"
        },
        {
          "command": "tmd.renderWAV",
          "when": "editorLangId == tmd",
          "group": "tmd_export@4"
        },
        {
          "command": "tmd.renderPDF",
          "when": "editorLangId == tmd",
          "group": "tmd_export@5"
        },
        {
          "command": "tmd.exportVSQX",
          "when": "editorLangId == tmd",
          "group": "tmd_export@6"
        },
        {
          "command": "tmd.exportVSQ",
          "when": "editorLangId == tmd",
          "group": "tmd_export@7"
        },
        {
          "command": "tmd.exportUST",
          "when": "editorLangId == tmd",
          "group": "tmd_export@8"
        },
        {
          "command": "tmd.formatDocument",
          "when": "editorLangId == tmd",
          "group": "tmd_tools@1"
        },
        {
          "command": "tmd.checkMeasures",
          "when": "editorLangId == tmd",
          "group": "tmd_tools@2"
        },
        {
          "command": "tmd.inspectSong",
          "when": "editorLangId == tmd",
          "group": "tmd_tools@3"
        },
        {
          "command": "tmd.refactorDoubleGrid",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@1"
        },
        {
          "command": "tmd.refactorHalveGrid",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@2"
        },
        {
          "command": "tmd.refactorOptimizeGrid",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@3"
        },
        {
          "command": "tmd.refactorTranspose",
          "when": "editorLangId == tmd && !editorHasSelection",
          "group": "tmd_refactor@4"
        },
        {
          "command": "tmd.refactorTransposeSelection",
          "when": "editorLangId == tmd && editorHasSelection",
          "group": "tmd_refactor@4"
        },
        {
          "command": "tmd.refactorDuplicateTrack",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@5"
        },
        {
          "command": "tmd.refactorGenerateHarmony",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@6"
        },
        {
          "command": "tmd.refactorInlineOrders",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@7"
        },
        {
          "command": "tmd.refactorRenameInstrument",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@8"
        },
        {
          "command": "tmd.refactorRenameSection",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@9"
        },
        {
          "command": "tmd.refactorExtractInstrument",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@10"
        }
      ],
      "editor/title": [
        {
          "command": "tmd.openMidiPlayer",
          "when": "editorLangId == tmd",
          "group": "navigation@1"
        },
        {
          "command": "tmd.openKeyboard",
          "when": "editorLangId == tmd",
          "group": "navigation@2"
        },
        {
          "command": "tmd.inspectSong",
          "when": "editorLangId == tmd",
          "group": "navigation@3"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "tmd",
        "name": "tmd",
        "description": "%tmd.chat.description%",
        "isDefault": false,
        "commands": [
          {
            "name": "check",
            "description": "%tmd.chat.check.description%"
          },
          {
            "name": "inspect",
            "description": "%tmd.chat.inspect.description%"
          },
          {
            "name": "compose",
            "description": "%tmd.chat.compose.description%"
          },
          {
            "name": "fix",
            "description": "%tmd.chat.fix.description%"
          },
          {
            "name": "explain",
            "description": "%tmd.chat.explain.description%"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "tmd_check",
        "toolReferenceName": "tmdCheck",
        "displayName": "%tmd.tools.check.displayName%",
        "modelDescription": "%tmd.tools.check.modelDescription%",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "The TMD score source code to validate. If omitted, the active editor's document is checked."
            },
            "filePath": {
              "type": "string",
              "description": "Optional file path to the .tmd file to check."
            }
          }
        }
      },
      {
        "name": "tmd_inspect",
        "toolReferenceName": "tmdInspect",
        "displayName": "%tmd.tools.inspect.displayName%",
        "modelDescription": "%tmd.tools.inspect.modelDescription%",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "The TMD score source code to inspect. If omitted, the active editor's document is inspected."
            },
            "filePath": {
              "type": "string",
              "description": "Optional file path to the .tmd file to inspect."
            },
            "asJson": {
              "type": "boolean",
              "description": "Whether to return the profile in structured JSON format instead of human-readable text report."
            }
          }
        }
      },
      {
        "name": "tmd_format",
        "toolReferenceName": "tmdFormat",
        "displayName": "%tmd.tools.format.displayName%",
        "modelDescription": "%tmd.tools.format.modelDescription%",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "The TMD score source code to format."
            }
          },
          "required": [
            "text"
          ]
        }
      },
      {
        "name": "tmd_get_specification",
        "toolReferenceName": "tmdSpecification",
        "displayName": "%tmd.tools.spec.displayName%",
        "modelDescription": "%tmd.tools.spec.modelDescription%",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "configuration": {
      "title": "TMD",
      "properties": {
        "tmd.executablePath": {
          "type": "string",
          "default": "",
          "description": "%tmd.config.executablePath%"
        },
        "tmd.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%tmd.config.checkOnSave%"
        },
        "tmd.checkOnChange": {
          "type": "boolean",
          "default": true,
          "description": "%tmd.config.checkOnChange%"
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./media/tmd-markdown-bundle.js"
    ],
    "markdown.previewStyles": [
      "./media/markdown-tmd-player.css"
    ]
  }
}
