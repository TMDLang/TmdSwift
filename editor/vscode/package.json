{
  "name": "tmd-vscode",
  "displayName": "TMD Language Support",
  "description": "Syntax highlighting, snippets, and language configuration for TMD (Timebase Mark Down)",
  "version": "0.1.0",
  "publisher": "zonble",
  "author": "zonble",
  "license": "MIT",
  "homepage": "https://github.com/zonble/TmdSwift",
  "repository": {
    "type": "git",
    "url": "https://github.com/zonble/TmdSwift.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tmd",
    "onCommand:tmd.openMidiPlayer"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tmd",
        "aliases": [
          "TMD",
          "tmd"
        ],
        "extensions": [
          ".tmd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tmd",
        "scopeName": "source.tmd",
        "path": "./syntaxes/tmd.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tmd",
        "path": "./snippets/tmd.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "tmd.exportMIDI",
        "title": "Export to MIDI (.mid)",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.exportMusicXML",
        "title": "Export to MusicXML (.musicxml)",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.exportABC",
        "title": "Export to ABC Notation (.abc)",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.exportLilyPond",
        "title": "Export to LilyPond (.ly)",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.renderPDF",
        "title": "Render to PDF via LilyPond (.pdf)",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.renderWAV",
        "title": "Render to WAV Audio (.wav)",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.exportVSQX",
        "title": "Export to VOCALOID3/4 (.vsqx)",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.exportVSQ",
        "title": "Export to VOCALOID2 (.vsq)",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.exportUST",
        "title": "Export to UTAU (.ust)",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.openMidiPlayer",
        "title": "Play Score in Web MIDI Player",
        "category": "TMD",
        "icon": "$(play-circle)",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.playAudio",
        "title": "Play Audio Preview in Terminal",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.installSkills",
        "title": "Install AI Agent Skills",
        "category": "TMD"
      },
      {
        "command": "tmd.formatDocument",
        "title": "Format Document",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.checkMeasures",
        "title": "Check Measure Consistency",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorDoubleGrid",
        "title": "Refactor: Double Grid Resolution (<4*> -> <8*>)",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorHalveGrid",
        "title": "Refactor: Halve Grid Resolution (<8*> -> <4*>)",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorDuplicateTrack",
        "title": "Refactor: Duplicate Track...",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorGenerateHarmony",
        "title": "Refactor: Generate Harmony...",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorInlineOrders",
        "title": "Refactor: Unroll / Inline Orders to Linear Score",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorRenameInstrument",
        "title": "Refactor: Rename Instrument...",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorRenameSection",
        "title": "Refactor: Rename Section...",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refactorExtractInstrument",
        "title": "Refactor: Extract Instrument Track...",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.playSection",
        "title": "Play Section",
        "category": "TMD",
        "icon": "$(play)"
      },
      {
        "command": "tmd.playTrack",
        "title": "Play Track (Solo)",
        "category": "TMD",
        "icon": "$(play)"
      },
      {
        "command": "tmd.playCurrentSection",
        "title": "Play Current Section at Cursor",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.playCurrentTrack",
        "title": "Play Current Track at Cursor",
        "category": "TMD",
        "enablement": "editorLangId == tmd"
      },
      {
        "command": "tmd.refreshOutline",
        "title": "Refresh Outline",
        "category": "TMD",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "tmdOutlineView",
          "name": "TMD Outline & Player",
          "when": "editorLangId == tmd || tmdHasActiveDocument"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tmd.refreshOutline",
          "when": "view == tmdOutlineView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tmd.playSection",
          "when": "view == tmdOutlineView && viewItem == sectionNode",
          "group": "inline"
        },
        {
          "command": "tmd.playTrack",
          "when": "view == tmdOutlineView && viewItem == trackNode",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "tmd.openMidiPlayer",
          "when": "editorLangId == tmd",
          "group": "tmd_preview@1"
        },
        {
          "command": "tmd.exportMIDI",
          "when": "editorLangId == tmd",
          "group": "tmd_export@1"
        },
        {
          "command": "tmd.exportMusicXML",
          "when": "editorLangId == tmd",
          "group": "tmd_export@2"
        },
        {
          "command": "tmd.exportABC",
          "when": "editorLangId == tmd",
          "group": "tmd_export@3"
        },
        {
          "command": "tmd.renderWAV",
          "when": "editorLangId == tmd",
          "group": "tmd_export@4"
        },
        {
          "command": "tmd.renderPDF",
          "when": "editorLangId == tmd",
          "group": "tmd_export@5"
        },
        {
          "command": "tmd.exportVSQX",
          "when": "editorLangId == tmd",
          "group": "tmd_export@6"
        },
        {
          "command": "tmd.exportVSQ",
          "when": "editorLangId == tmd",
          "group": "tmd_export@7"
        },
        {
          "command": "tmd.exportUST",
          "when": "editorLangId == tmd",
          "group": "tmd_export@8"
        },
        {
          "command": "tmd.formatDocument",
          "when": "editorLangId == tmd",
          "group": "tmd_tools@1"
        },
        {
          "command": "tmd.checkMeasures",
          "when": "editorLangId == tmd",
          "group": "tmd_tools@2"
        },
        {
          "command": "tmd.refactorDoubleGrid",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@1"
        },
        {
          "command": "tmd.refactorHalveGrid",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@2"
        },
        {
          "command": "tmd.refactorDuplicateTrack",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@3"
        },
        {
          "command": "tmd.refactorGenerateHarmony",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@4"
        },
        {
          "command": "tmd.refactorInlineOrders",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@5"
        },
        {
          "command": "tmd.refactorRenameInstrument",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@6"
        },
        {
          "command": "tmd.refactorRenameSection",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@7"
        },
        {
          "command": "tmd.refactorExtractInstrument",
          "when": "editorLangId == tmd",
          "group": "tmd_refactor@8"
        }
      ],
      "editor/title": [
        {
          "command": "tmd.openMidiPlayer",
          "when": "editorLangId == tmd",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "TMD",
      "properties": {
        "tmd.executablePath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the tmd command line tool. If empty, the extension looks for 'tmd' in the system PATH."
        },
        "tmd.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check measure consistency on save and display diagnostics in the Problems panel."
        },
        "tmd.checkOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check measure consistency as you type (debounced) and update the Problems panel."
        }
      }
    }
  }
}
